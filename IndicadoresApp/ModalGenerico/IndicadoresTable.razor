<table class="table table-bordered">
    <thead>
        <tr>
            <th>Código</th>
            <th>Nombre</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var indicador in Indicadores)
        {
            <tr>
                <td>@indicador["codigo"]</td>
                <td>@indicador["nombre"]</td>
                <td>
                    <button @onclick="() => OnEdit(indicador)" class="btn btn-sm btn-primary">Editar</button>
                    <button @onclick="() => OnDelete(indicador)" class="btn btn-sm btn-danger">Eliminar</button>
                </td>
            </tr>
        }
    </tbody>
</table>

@code {
    [Parameter] public List<Dictionary<string, object>> Indicadores { get; set; }
    [Parameter] public EventCallback<Dictionary<string, object>> OnEdit { get; set; }
    [Parameter] public EventCallback<Dictionary<string, object>> OnDelete { get; set; }
}