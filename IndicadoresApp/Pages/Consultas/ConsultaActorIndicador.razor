@page "/reporte-indicador-responsable"
@using System.Collections.Generic
@using System.Text.Json
@inject ServicioEntidad servicioEntidad
@inject IJSRuntime JSRuntime

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <h3 class="mb-0">
                    <i class="fas fa-chart-bar me-2"></i>
                    Reporte: Indicadores con Responsables y Actores
                </h3>
                <div class="btn-group">
                    <button class="btn btn-primary" @onclick="CargarReporte" disabled="@cargando">
                        @if (cargando)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        }
                        else
                        {
                            <i class="fas fa-sync-alt me-2"></i>
                        }
                        Actualizar
                    </button>
                    <button class="btn btn-success" @onclick="ExportarCSV" disabled="@(datosReporte.Count == 0)">
                        <i class="fas fa-file-csv me-2"></i>
                        Exportar CSV
                    </button>
                </div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(errorMensaje))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>
            @errorMensaje
            <button type="button" class="btn-close" @onclick="() => errorMensaje = string.Empty"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(mensajeExito))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>
            @mensajeExito
            <button type="button" class="btn-close" @onclick="() => mensajeExito = string.Empty"></button>
        </div>
    }

    @if (cargando)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <p class="mt-3 text-muted">Generando reporte...</p>
        </div>
    }
    else if (datosReporte.Count == 0 && !primeraCarga)
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">
                <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
                <h5 class="text-muted">No hay datos disponibles</h5>
                <p class="text-muted">Haz clic en "Actualizar" para cargar el reporte</p>
            </div>
        </div>
    }
    else if (datosReporte.Count > 0)
    {
        <!-- Resumen estadístico -->
        <div class="row mb-4">
            <div class="col-md-3">
                <div class="card bg-primary text-white">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <div>
                                <h4 class="mb-0">@totalIndicadores</h4>
                                <p class="mb-0">Total Indicadores</p>
                            </div>
                            <i class="fas fa-tachometer-alt fa-2x opacity-75"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-success text-white">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <div>
                                <h4 class="mb-0">@indicadoresConResponsables</h4>
                                <p class="mb-0">Con Responsables</p>
                            </div>
                            <i class="fas fa-user-check fa-2x opacity-75"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-warning text-white">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <div>
                                <h4 class="mb-0">@indicadoresSinResponsables</h4>
                                <p class="mb-0">Sin Responsables</p>
                            </div>
                            <i class="fas fa-user-times fa-2x opacity-75"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-info text-white">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <div>
                                <h4 class="mb-0">@totalResponsables</h4>
                                <p class="mb-0">Total Responsables</p>
                            </div>
                            <i class="fas fa-users fa-2x opacity-75"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Filtros -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-light">
                <h6 class="mb-0">
                    <i class="fas fa-filter me-2"></i>
                    Filtros de Búsqueda
                </h6>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Buscar por nombre/código:</label>
                        <input type="text" class="form-control" @bind="filtroTexto" @oninput="FiltrarDatos" 
                               placeholder="Escriba para filtrar...">
                    </div>
                  @*   <div class="col-md-4">
                        <label class="form-label">Tipo de Actor:</label>
                        <select class="form-select" @bind="filtroTipoActor" @onchange="FiltrarDatos">
                            <option value="">Todos los tipos</option>
                            @foreach (var tipo in tiposActorUnicos)
                            {
                                <option value="@tipo">@tipo</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Estado:</label>
                        <select class="form-select" @bind="filtroEstado" @onchange="FiltrarDatos">
                            <option value="">Todos</option>
                            <option value="con_responsable">Con Responsable</option>
                            <option value="sin_responsable">Sin Responsable</option>
                        </select>
                    </div> *@
                </div>
            </div>
        </div>

        <!-- Tabla de datos -->
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                <h6 class="mb-0">
                    <i class="fas fa-table me-2"></i>
                    Detalle del Reporte (@datosFiltrados.Count registros)
                </h6>
                <small class="text-muted">
                    Última actualización: @fechaUltimaActualizacion.ToString("dd/MM/yyyy HH:mm")
                </small>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th class="text-center" style="width: 80px;">ID</th>
                                <th style="min-width: 120px;">Código</th>
                                <th style="min-width: 200px;">Nombre Indicador</th>
                                <th style="min-width: 250px;">Objetivo</th>
                                <th style="min-width: 200px;">Fórmula</th>
                                <th style="min-width: 100px;">Meta</th>
                                <th style="min-width: 180px;">Responsable</th>
                                <th style="min-width: 150px;">Tipo Actor</th>
                                <th class="text-center" style="width: 100px;">Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var registro in datosFiltrados)
                            {
                                <tr>
                                    <td class="text-center">
                                        <span class="badge bg-secondary">@registro["ID_Indicador"]</span>
                                    </td>
                                    <td>
                                        <code class="text-primary">@registro["Codigo_Indicador"]</code>
                                    </td>
                                    <td>
                                        <strong>@registro["Nombre_Indicador"]</strong>
                                    </td>
                                    <td>
                                        <div class="text-truncate" style="max-width: 250px;" 
                                             title="@registro["Objetivo_Indicador"]">
                                            @registro["Objetivo_Indicador"]
                                        </div>
                                    </td>
                                    <td>
                                        <div class="text-truncate" style="max-width: 200px;" 
                                             title="@registro["Formula_Indicador"]">
                                            <small class="font-monospace">@registro["Formula_Indicador"]</small>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge bg-info">@registro["Meta_Indicador"]</span>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(registro["Nombre_Responsable"]?.ToString()))
                                        {
                                            <span class="text-success">
                                                <i class="fas fa-user me-1"></i>
                                                @registro["Nombre_Responsable"]
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                <i class="fas fa-user-slash me-1"></i>
                                                Sin asignar
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(registro["Nombre_Tipo_Actor"]?.ToString()))
                                        {
                                            <span class="badge bg-primary">@registro["Nombre_Tipo_Actor"]</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">N/A</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (!string.IsNullOrEmpty(registro["Nombre_Responsable"]?.ToString()))
                                        {
                                            <i class="fas fa-check-circle text-success" title="Tiene responsable asignado"></i>
                                        }
                                        else
                                        {
                                            <i class="fas fa-exclamation-triangle text-warning" title="Sin responsable asignado"></i>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<Dictionary<string, object>> datosReporte = new();
    private List<Dictionary<string, object>> datosFiltrados = new();
    private List<string> tiposActorUnicos = new();
    
    private bool cargando = false;
    private bool primeraCarga = true;
    private string errorMensaje = string.Empty;
    private string mensajeExito = string.Empty;
    private DateTime fechaUltimaActualizacion = DateTime.Now;

    // Filtros
    private string filtroTexto = string.Empty;
    private string filtroTipoActor = string.Empty;
    private string filtroEstado = string.Empty;

    // Estadísticas
    private int totalIndicadores = 0;
    private int indicadoresConResponsables = 0;
    private int indicadoresSinResponsables = 0;
    private int totalResponsables = 0;

    protected override async Task OnInitializedAsync()
    {
        await CargarReporte();
    }

    private async Task CargarReporte()
    {
        cargando = true;
        errorMensaje = string.Empty;
        
        try
        {
            var parametros = new Dictionary<string, object>();
            
            var resultado = await servicioEntidad.EjecutarProcedimientoAsync(
                "indicador", // tabla base (puede ser cualquiera)
                "Sp_IndicadorResponsableActor",
                parametros
            );

            if (resultado != null && resultado is List<Dictionary<string, object>> lista)
            {
                datosReporte = lista;
                CalcularEstadisticas();
                ObtenerTiposActorUnicos();
                FiltrarDatos();
                fechaUltimaActualizacion = DateTime.Now;
                mensajeExito = $"Reporte cargado exitosamente. {datosReporte.Count} registros encontrados.";
                
                await JSRuntime.InvokeVoidAsync("console.log", 
                    "Datos del reporte cargados:", JsonSerializer.Serialize(datosReporte));
            }
            else
            {
                datosReporte.Clear();
                errorMensaje = "No se pudieron obtener los datos del reporte.";
            }
        }
        catch (Exception ex)
        {
            errorMensaje = $"Error al cargar el reporte: {ex.Message}";
            await JSRuntime.InvokeVoidAsync("console.error", "Error en CargarReporte:", ex.Message);
        }
        finally
        {
            cargando = false;
            primeraCarga = false;
            StateHasChanged();
        }
    }

    private void CalcularEstadisticas()
    {
        if (datosReporte.Count == 0) return;

        var indicadoresUnicos = datosReporte
            .GroupBy(r => r["ID_Indicador"]?.ToString())
            .Select(g => g.First())
            .ToList();

        totalIndicadores = indicadoresUnicos.Count;
        
        indicadoresConResponsables = indicadoresUnicos
            .Count(r => !string.IsNullOrEmpty(r["Nombre_Responsable"]?.ToString()));
        
        indicadoresSinResponsables = totalIndicadores - indicadoresConResponsables;
        
        totalResponsables = datosReporte
            .Where(r => !string.IsNullOrEmpty(r["Nombre_Responsable"]?.ToString()))
            .GroupBy(r => r["Nombre_Responsable"]?.ToString())
            .Count();
    }

    private void ObtenerTiposActorUnicos()
    {
        tiposActorUnicos = datosReporte
            .Where(r => !string.IsNullOrEmpty(r["Nombre_Tipo_Actor"]?.ToString()))
            .Select(r => r["Nombre_Tipo_Actor"]?.ToString())
            .Distinct()
            .OrderBy(t => t)
            .ToList();
    }

    private void FiltrarDatos()
    {
        datosFiltrados = datosReporte.Where(registro =>
        {
            // Filtro por texto (nombre o código)
            if (!string.IsNullOrEmpty(filtroTexto))
            {
                var nombre = registro["Nombre_Indicador"]?.ToString()?.ToLower() ?? "";
                var codigo = registro["Codigo_Indicador"]?.ToString()?.ToLower() ?? "";
                var textoFiltro = filtroTexto.ToLower();
                
                if (!nombre.Contains(textoFiltro) && !codigo.Contains(textoFiltro))
                    return false;
            }

            // Filtro por tipo de actor
            if (!string.IsNullOrEmpty(filtroTipoActor))
            {
                var tipoActor = registro["Nombre_Tipo_Actor"]?.ToString() ?? "";
                if (tipoActor != filtroTipoActor)
                    return false;
            }

            // Filtro por estado (con/sin responsable)
            if (!string.IsNullOrEmpty(filtroEstado))
            {
                var tieneResponsable = !string.IsNullOrEmpty(registro["Nombre_Responsable"]?.ToString());
                
                if (filtroEstado == "con_responsable" && !tieneResponsable)
                    return false;
                
                if (filtroEstado == "sin_responsable" && tieneResponsable)
                    return false;
            }

            return true;
        }).ToList();

        StateHasChanged();
    }

    private async Task ExportarCSV()
    {
        try
        {
            var csv = new System.Text.StringBuilder();
            
            // Encabezados
            csv.AppendLine("ID_Indicador,Codigo_Indicador,Nombre_Indicador,Objetivo_Indicador,Formula_Indicador,Meta_Indicador,Nombre_Responsable,Nombre_Tipo_Actor");
            
            // Datos
            foreach (var registro in datosFiltrados)
            {
                csv.AppendLine($"\"{registro["ID_Indicador"]}\",\"{registro["Codigo_Indicador"]}\",\"{registro["Nombre_Indicador"]}\",\"{registro["Objetivo_Indicador"]}\",\"{registro["Formula_Indicador"]}\",\"{registro["Meta_Indicador"]}\",\"{registro["Nombre_Responsable"]}\",\"{registro["Nombre_Tipo_Actor"]}\"");
            }

            var fileName = $"ReporteIndicadorResponsable_{DateTime.Now:yyyyMMdd_HHmmss}.csv";
            var bytes = System.Text.Encoding.UTF8.GetBytes(csv.ToString());
            var base64 = Convert.ToBase64String(bytes);
            
            await JSRuntime.InvokeVoidAsync("downloadFile", fileName, base64, "text/csv");
            mensajeExito = "Archivo CSV exportado exitosamente.";
        }
        catch (Exception ex)
        {
            errorMensaje = $"Error al exportar CSV: {ex.Message}";
        }
    }
}

<script>
    window.downloadFile = (filename, base64String, mimeType) => {
        const link = document.createElement('a');
        link.download = filename;
        link.href = `data:${mimeType};base64,${base64String}`;
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
    };
</script>

<style>
    .table th {
        position: sticky;
        top: 0;
        background-color: var(--bs-dark) !important;
        z-index: 10;
    }
    
    .opacity-75 {
        opacity: 0.75;
    }
    
    .font-monospace {
        font-family: 'Courier New', monospace;
    }
</style>