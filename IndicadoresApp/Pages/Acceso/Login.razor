@page "/login"
@using System.Net.Http.Json
@using IndicadoresApp.Clases.IndicadoresApp.Clases
@using IndicadoresApp.Services
@using IndicadoresApp.Clases
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inherits IndicadoresApp.Services.ValidacionAcceso

<section class="vh-100 d-flex align-items-center justify-content-center login-full-height">
    <div class="container-fluid py-5">
        <div class="row d-flex justify-content-center align-items-center">
            <div class="col-md-9 col-lg-6 col-xl-5 d-none d-md-block">
                <img src="https://cdni.iconscout.com/illustration/premium/thumb/login-page-4468581-3783955.png"
                     class="img-fluid login-image" alt="Imagen de Login">
            </div>

            <div class="col-md-8 col-lg-6 col-xl-4 offset-xl-1">
                <div class="card login-card shadow-lg rounded-3">
                    <div class="card-body p-5">
                        <EditForm Model="@modeloLogin" OnValidSubmit="ManejarLogin">
                            <div class="text-center mb-5">
                                <h2 class="fw-bold login-title">¡Bienvenido de nuevo!</h2>
                                <p class="text-muted">Ingresa tus credenciales para continuar.</p>
                            </div>

                            <div class="form-floating mb-4">
                                <InputText id="emailInput" class="form-control form-control-lg"
                                           @bind-Value="modeloLogin.Correo" placeholder=" " />
                                <label for="emailInput">Correo electrónico</label>
                                <ValidationMessage For="@(() => modeloLogin.Correo)" class="text-danger small mt-1" />
                            </div>

                            <div class="form-floating mb-4">
                                <InputText id="passwordInput" type="password" class="form-control form-control-lg"
                                           @bind-Value="modeloLogin.Contrasena" placeholder=" " />
                                <label for="passwordInput">Contraseña</label>
                                <ValidationMessage For="@(() => modeloLogin.Contrasena)" class="text-danger small mt-1" />
                            </div>

                            <div class="d-grid gap-2 mb-4">
                                <button type="submit" class="btn btn-primary btn-lg login-button">
                                    <i class="bi bi-box-arrow-in-right me-2"></i>Iniciar Sesión
                                </button>
                            </div>

                            <div class="text-center">
                                <p class="small text-muted">
                                    ¿No tienes una cuenta? <a href="/registro" class="text-primary fw-bold login-register-link">Regístrate aquí</a>
                                </p>
                            </div>

                            @if (!string.IsNullOrEmpty(mensajeError))
                            {
                                <div class="alert alert-danger mt-4 text-center login-error-message" role="alert">
                                    @mensajeError
                                </div>
                            }
                        </EditForm>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private ModeloLogin modeloLogin = new ModeloLogin();
    private string mensajeError = string.Empty;

    /// <summary>
    /// Manejar el proceso de login cuando el formulario se envía de manera válida.
    /// </summary>
    private async Task ManejarLogin()
    {
        try
        {
            mensajeError = string.Empty;

            var datosVerificar = new Dictionary<string, string>
            {
                { "campoUsuario", "email" },
                { "campoContrasena", "contrasena" },
                { "valorUsuario", modeloLogin.Correo },
                { "valorContrasena", modeloLogin.Contrasena }
            };

            Console.WriteLine($"Enviando solicitud a: {Http.BaseAddress}usuario/verificar-contrasena");

            var respuestaVerificar = await Http.PostAsJsonAsync("usuario/verificar-contrasena", datosVerificar);

            Console.WriteLine($"Código de respuesta: {respuestaVerificar.StatusCode}");

            if (respuestaVerificar.IsSuccessStatusCode)
            {
                await JSRuntime.InvokeVoidAsync("console.log", "Login exitoso.");

                var jsonConsultaRoles = new
                {
                    consulta = @"SELECT u.email AS EmailUsuario, r.nombre AS NombreRol
                                 FROM usuario u
                                 INNER JOIN rol_usuario ru ON u.email = ru.fkemail
                                 INNER JOIN rol r ON ru.fkidrol = r.id
                                 WHERE u.email = @EmailUsuario",
                    parametros = new { EmailUsuario = modeloLogin.Correo }
                };

                var respuestaRoles = await Http.PostAsJsonAsync(
                    "tabla/ejecutar-consulta-parametrizada",
                    jsonConsultaRoles
                );

                if (respuestaRoles.IsSuccessStatusCode)
                {
                    var listaRoles = await respuestaRoles.Content.ReadFromJsonAsync<List<Dictionary<string, object>>>();

                    if (listaRoles != null && listaRoles.Any())
                    {
                        await JSRuntime.InvokeVoidAsync("sessionStorage.setItem", "usuarioEmail", modeloLogin.Correo);

                        foreach (var rol in listaRoles)
                        {
                            if (rol.TryGetValue("NombreRol", out object? nombreRolObj) && nombreRolObj is not null)
                            {
                                var nombreRol = nombreRolObj.ToString();

                                if (!string.IsNullOrEmpty(nombreRol))
                                {
                                    await JSRuntime.InvokeVoidAsync("sessionStorage.setItem", "rolUsuario", nombreRol);

                                    if (RutasPermisosService.EsRolTodosAccesos(nombreRol))
                                    {
                                        foreach (var ruta in RutasPermisosService.TodasLasRutas)
                                        {
                                            await JSRuntime.InvokeVoidAsync(
                                                "sessionStorage.setItem",
                                                $"ruta_{ruta}",
                                                ruta
                                            );
                                            Console.WriteLine($"Admin: Asignada ruta {ruta}");
                                        }
                                    }
                                    else if (RutasPermisosService.EsRolVerificadorOValidador(nombreRol))
                                    {
                                        var rutasPermitidas = RutasPermisosService.ObtenerRutasVerificador();
                                        var tipoRol = RutasPermisosService.EsRolVerificador(nombreRol) ? "Verificador" : "Validador";

                                        foreach (var ruta in rutasPermitidas)
                                        {
                                            await JSRuntime.InvokeVoidAsync(
                                                "sessionStorage.setItem",
                                                $"ruta_{ruta}",
                                                ruta
                                            );
                                            Console.WriteLine($"{tipoRol}: Asignada ruta {ruta}");
                                        }
                                    }
                                    else
                                    {
                                        var jsonConsultaRutas = new
                                        {
                                            consulta = "SELECT Ruta FROM rutarol WHERE Rol = @Rol",
                                            parametros = new { Rol = nombreRol }
                                        };

                                        var respuestaRutas = await Http.PostAsJsonAsync(
                                            "tabla/ejecutar-consulta-parametrizada",
                                            jsonConsultaRutas
                                        );

                                        if (respuestaRutas.IsSuccessStatusCode)
                                        {
                                            var listaRutas = await respuestaRutas.Content.ReadFromJsonAsync<List<Dictionary<string, object>>>();

                                            if (listaRutas != null)
                                            {
                                                foreach (var ruta in listaRutas)
                                                {
                                                    if (ruta.TryGetValue("Ruta", out object? nombreRutaObj) && nombreRutaObj is not null)
                                                    {
                                                        var nombreRuta = nombreRutaObj.ToString();

                                                        if (!string.IsNullOrEmpty(nombreRuta))
                                                        {
                                                            await JSRuntime.InvokeVoidAsync(
                                                                "sessionStorage.setItem",
                                                                $"ruta_{nombreRuta}",
                                                                nombreRuta
                                                            );
                                                            Console.WriteLine($"Usuario: Asignada ruta {nombreRuta}");
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        await JSRuntime.InvokeVoidAsync("alert", "Inicio de sesión exitoso.");
                        Navigation.NavigateTo("/");
                        await JSRuntime.InvokeVoidAsync("location.reload");
                    }
                    else
                    {
                        mensajeError = "No se encontraron roles para el usuario.";
                    }
                }
                else
                {
                    var errorContenido = await respuestaRoles.Content.ReadAsStringAsync();
                    Console.WriteLine($"Error al obtener roles: {errorContenido}");
                    mensajeError = "Error al obtener los roles del usuario.";
                }
            }
            else if (respuestaVerificar.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                mensajeError = "Usuario o contraseña incorrectos.";
            }
            else
            {
                var errorContent = await respuestaVerificar.Content.ReadAsStringAsync();
                Console.WriteLine($"Error en la respuesta HTTP: {errorContent}");
                mensajeError = "Error al iniciar sesión. Por favor, intente de nuevo.";
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error en el proceso de login: {ex.Message}");
            Console.WriteLine($"StackTrace: {ex.StackTrace}");
            mensajeError = $"Error inesperado: {ex.Message}";
        }
    }

    /// <summary>
    /// Modelo de datos utilizado para capturar el correo electrónico y la contraseña ingresados por el usuario en el formulario de login.
    /// </summary>
    public class ModeloLogin
    {
        public string Correo { get; set; } = string.Empty;
        public string Contrasena { get; set; } = string.Empty;
    }
}