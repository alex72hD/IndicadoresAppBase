@page "/Variable"
@using System.Collections.Generic
@using IndicadoresApp.Clases.IndicadoresApp.Clases
@using IndicadoresApp.ModalGenerico
@inject IJSRuntime JSRuntime
@inject ServicioEntidad ServicioEntidad
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inherits ValidacionAcceso
<PageTitle>Variables</PageTitle>

<h1>Variables</h1>
@* Solo los verificadores y validadores no pueden crear *@
@if (!EsVerificador && !EsValidador)
{
    <div class="mb-3">
        <button class="btn btn-primary" @onclick="MostrarFormularioCrear">Crear Nuevo</button>
    </div>
}

<div class="mb-3">
    <div class="row">
        <div class="col-md-6">
            <div class="input-group">
                <input type="text"
                       class="form-control"
                       placeholder="Buscar por nombre o email..."
                       @bind="TextoBusqueda"
                       @oninput="FiltrarVariables" />
                <button class="btn btn-outline-secondary" type="button" @onclick="LimpiarBusqueda">
                    <i class="fas fa-times"></i> Limpiar
                </button>
            </div>
        </div>
        <div class="col-md-6">
            <small class="text-muted">
                Mostrando @VariablesFiltradas.Count de @Variables.Count variables
            </small>
        </div>
    </div>
</div>

@if (EstamosCargando)
{
    <p><em>Cargando...</em></p>
}
else if (Variables == null || Variables.Count == 0)
{
    <p>No hay variables registradas.</p>
}
else if (VariablesFiltradas.Count == 0 && !string.IsNullOrEmpty(TextoBusqueda))
{
    <div class="alert alert-info">
        <i class="fas fa-search"></i> No se encontraron variables que coincidan con "<strong>@TextoBusqueda</strong>"
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Fecha</th>
                    <th>Email</th>
                    @* Solo los verificadores y validadores no ven las acciones de crear/eliminar *@
                    @if (!EsVerificador && !EsValidador)
                    {
                        <th>Acciones</th>
                    }
                    @* Los validadores solo pueden editar, así que necesitan ver la columna de acciones si solo son validadores y no verificadores *@
                    @if (EsValidador && !EsVerificador)
                    {
                        <th>Acciones</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var variable in VariablesFiltradas)
                {
                    <tr>
                        <td>@ObtenerValor(variable, "nombre")</td>
                        <td>@ObtenerValor(variable, "fechacreacion")</td>
                        <td>@ObtenerValor(variable, "fkemailusuario")</td>
                        @* Administradores pueden hacer todo *@
                        @if (!EsVerificador && !EsValidador)
                        {
                            <td>
                                <button class="btn btn-warning btn-sm" @onclick="() => MostrarFormularioEditar(variable)">Editar</button>
                                <button class="btn btn-danger btn-sm" @onclick="() => ConfirmarEliminar(variable)">Eliminar</button>
                            </td>
                        }
                        @* Los validadores solo pueden editar *@
                        @if (EsValidador && !EsVerificador)
                        {
                            <td>
                                <button class="btn btn-warning btn-sm" @onclick="() => MostrarFormularioEditar(variable)">Editar</button>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<ModalGenerico @ref="modalFormulario"
               Id="formModal"
               Title="@TituloModal"
               OnSave="GuardarVariable">
    <BodyContent>
        <div class="mb-3">
            <label for="nombre" class="form-label">Nombre</label>
            <input type="text" class="form-control" id="nombre" @bind="VariableActual.Nombre" />
        </div>
        @* Solo mostrar el campo de email en modo edición *@
        @if (ModoEdicion)
        {
            <div class="mb-3">
                <label for="email" class="form-label">Email</label>
                <input type="email" class="form-control" id="email" @bind="VariableActual.FkEmail" />
            </div>
        }
        else
        {
            <div class="mb-3">
                <label class="form-label">Email</label>
                <p class="form-control-plaintext">@EmailUsuarioLogueado</p>
                <small class="text-muted">Se usará tu email actual para crear la variable</small>
            </div>
        }
    </BodyContent>
</ModalGenerico>

<ModalGenerico @ref="modalConfirmacion"
               Id="confirmModal"
               Title="Confirmar eliminación"
               OnSave="EliminarVariable">
    <BodyContent>
        <p>¿Está seguro que desea eliminar la variable @VariableAEliminar.Nombre?</p>
    </BodyContent>
</ModalGenerico>

@if (!string.IsNullOrEmpty(MensajeError))
{
    <div class="alert alert-danger">
        Error: @MensajeError
    </div>
}

@if (!string.IsNullOrEmpty(MensajeExito))
{
    <div class="alert alert-success">
        @MensajeExito
    </div>
}

@code {
    private const string NOMBRE_TABLA = "variable";

    private List<Dictionary<string, object>> Variables { get; set; } = new();
    private List<Dictionary<string, object>> VariablesFiltradas { get; set; } = new(); // New list for filtered data
    private bool EstamosCargando { get; set; } = true;
    private string? MensajeError { get; set; }
    private string? MensajeExito { get; set; }
    private bool EsVerificador { get; set; } = false;
    private bool EsValidador { get; set; } = false; // Added: Declaration of EsValidador
    private string EmailUsuarioLogueado { get; set; } = string.Empty; // Nuevo: Email del usuario logueado

    // Propiedad para la búsqueda
    private string TextoBusqueda { get; set; } = string.Empty;

    private bool ModoEdicion { get; set; } = false;
    private VariableModel VariableActual { get; set; } = new();
    private ModalGenerico? modalFormulario;
    private string TituloModal => $"{(ModoEdicion ? "Editar" : "Crear")} Variable";

    private VariableModel VariableAEliminar { get; set; } = new();
    private ModalGenerico? modalConfirmacion;

    protected override async Task OnInitializedAsync()
    {
        var rol = await JSRuntime.InvokeAsync<string>("sessionStorage.getItem", "rolUsuario");
        EmailUsuarioLogueado = await JSRuntime.InvokeAsync<string>("sessionStorage.getItem", "usuarioEmail") ?? string.Empty; // Nuevo: Obtener email del usuario
        EsVerificador = RutasPermisosService.EsRolVerificador(rol);
        EsValidador = RutasPermisosService.EsRolValidador(rol); // Added: Initialization of EsValidador
        await CargarVariables();
    }

    private async Task CargarVariables()
    {
        EstamosCargando = true;
        MensajeError = null;

        try
        {
            Variables = await ServicioEntidad.ObtenerTodosAsync(NOMBRE_TABLA) ?? new List<Dictionary<string, object>>();
            VariablesFiltradas = new List<Dictionary<string, object>>(Variables); // Initialize filtered list

            // Apply filter if there's existing search text
            if (!string.IsNullOrEmpty(TextoBusqueda))
            {
                FiltrarVariables();
            }
        }
        catch (Exception ex)
        {
            MensajeError = $"Error al cargar variables: {ex.Message}";
            Variables = new List<Dictionary<string, object>>();
            VariablesFiltradas = new List<Dictionary<string, object>>();
        }
        finally
        {
            EstamosCargando = false;
        }
    }

    private string ObtenerValor(Dictionary<string, object> diccionario, string clave)
    {
        return diccionario.TryGetValue(clave, out var valor) ? valor?.ToString() ?? string.Empty : string.Empty;
    }

    private void FiltrarVariables(ChangeEventArgs? e = null)
    {
        if (e != null)
        {
            TextoBusqueda = e.Value?.ToString() ?? string.Empty;
        }

        if (string.IsNullOrEmpty(TextoBusqueda))
        {
            VariablesFiltradas = new List<Dictionary<string, object>>(Variables);
        }
        else
        {
            var textoBusquedaLower = TextoBusqueda.ToLower().Trim();

            VariablesFiltradas = Variables.Where(variable =>
            {
                var nombre = ObtenerValor(variable, "nombre").ToLower();
                var email = ObtenerValor(variable, "fkemailusuario").ToLower();
                // If you want to search by date, you'll need to parse and format it consistently
                var fechaCreacion = ObtenerValor(variable, "fechacreacion").ToLower();


                return nombre.Contains(textoBusquedaLower) ||
                       email.Contains(textoBusquedaLower) ||
                       fechaCreacion.Contains(textoBusquedaLower); // Simple string contains for date
            }).ToList();
        }

        StateHasChanged(); // Notify Blazor that the state has changed and UI should re-render
    }

    private void LimpiarBusqueda()
    {
        TextoBusqueda = string.Empty;
        VariablesFiltradas = new List<Dictionary<string, object>>(Variables);
        StateHasChanged();
    }

    private async Task MostrarFormularioCrear()
    {
        // Modified: Verifiers and Validators cannot create
        if (EsVerificador || EsValidador)
            return;
        VariableActual = new VariableModel();
        ModoEdicion = false;
        await modalFormulario.ShowModalAsync();
    }

    private async Task MostrarFormularioEditar(Dictionary<string, object> variable)
    {
        // Modified: Only verifiers cannot edit (validators can edit)
        if (EsVerificador)
            return;
        VariableActual = new VariableModel
            {
                Id = Convert.ToInt32(ObtenerValor(variable, "id")),
                Nombre = ObtenerValor(variable, "nombre"),
                FkEmail = ObtenerValor(variable, "fkemailusuario")
            };
        ModoEdicion = true;
        await modalFormulario.ShowModalAsync();
    }

    private async Task ConfirmarEliminar(Dictionary<string, object> variable)
    {
        // Modified: Verifiers and Validators cannot delete
        if (EsVerificador || EsValidador)
            return;
        VariableAEliminar = new VariableModel
            {
                Id = Convert.ToInt32(ObtenerValor(variable, "id")),
                Nombre = ObtenerValor(variable, "nombre")
            };
        await modalConfirmacion.ShowModalAsync();
    }

    private async Task GuardarVariable()
    {
        // Modified: Verifiers cannot save (create or edit)
        if (EsVerificador)
            return;

        // Added: Validators cannot create, only edit
        if (EsValidador && !ModoEdicion)
            return;

        MensajeError = null;
        MensajeExito = null;

        try
        {
            if (string.IsNullOrWhiteSpace(VariableActual.Nombre))
            {
                MensajeError = "El nombre es obligatorio";
                return;
            }

            // Modificado: Usar el email del usuario logueado al crear, y permitir editar el email en modo edición
            var emailAUsar = ModoEdicion ? VariableActual.FkEmail : EmailUsuarioLogueado;

            var variableData = new Dictionary<string, object>
                {
                    ["nombre"] = VariableActual.Nombre,
                    ["fkemailusuario"] = emailAUsar,
                    ["fechacreacion"] = DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss")
                };

            bool resultado;

            if (ModoEdicion)
            {
                resultado = await ServicioEntidad.ActualizarAsync(
                    NOMBRE_TABLA,
                    "id",
                    VariableActual.Id.ToString(),
                    variableData
                );

                if (resultado)
                {
                    MensajeExito = "Variable actualizada correctamente";
                }
            }
            else
            {
                resultado = await ServicioEntidad.CrearAsync(
                    NOMBRE_TABLA,
                    variableData
                );

                if (resultado)
                {
                    MensajeExito = "Variable creada correctamente";
                }
            }

            if (resultado)
            {
                await CargarVariables();
                await modalFormulario.HideModalAsync();
            }
            else
            {
                MensajeError = "Error al guardar la variable";
            }
        }
        catch (Exception ex)
        {
            MensajeError = $"Error: {ex.Message}";
        }
    }

    private async Task EliminarVariable()
    {
        // Modified: Verifiers and Validators cannot delete
        if (EsVerificador || EsValidador)
            return;

        MensajeError = null;
        MensajeExito = null;

        try
        {
            var resultado = await ServicioEntidad.EliminarAsync(
                NOMBRE_TABLA,
                "id",
                VariableAEliminar.Id.ToString()
            );

            if (resultado)
            {
                MensajeExito = "Variable eliminada correctamente";
                await CargarVariables();
                await modalConfirmacion.HideModalAsync();
            }
            else
            {
                MensajeError = "Error al eliminar la variable";
            }
        }
        catch (Exception ex)
        {
            MensajeError = $"Error: {ex.Message}";
        }
    }
}