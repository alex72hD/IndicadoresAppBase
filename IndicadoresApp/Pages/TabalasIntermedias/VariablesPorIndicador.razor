@page "/VariablePorIndicador"
@using System.Collections.Generic
@using System.Text.Json
@using IndicadoresApp.Clases.IndicadoresApp.Clases
@using IndicadoresApp.ModalGenerico
@inject IJSRuntime JSRuntime
@inject ServicioEntidad ServicioEntidad
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inherits ValidacionAcceso
<PageTitle>Variables por indicador</PageTitle>

<h1>Variables por Indicador</h1>
@* Solo los verificadores y validadores no pueden crear *@
@if (!EsVerificador && !EsValidador)
{
    <div class="mb-3">
        <button class="btn btn-primary" @onclick="MostrarFormularioCrear">Crear Nuevo</button>
    </div>
}

<div class="mb-3">
    <div class="row">
        <div class="col-md-6">
            <div class="input-group">
                <input type="text"
                       class="form-control"
                       placeholder="Buscar por ID de Variable, ID de Indicador, Dato o Email..."
                       @bind="TextoBusqueda"
                       @oninput="FiltrarVariables" />
                <button class="btn btn-outline-secondary" type="button" @onclick="LimpiarBusqueda">
                    <i class="fas fa-times"></i> Limpiar
                </button>
            </div>
        </div>
        <div class="col-md-6">
            <small class="text-muted">
                Mostrando @VariablesFiltradas.Count de @Variables.Count variables
            </small>
        </div>
    </div>
</div>

@if (EstamosCargando)
{
    <p><em>Cargando...</em></p>
}
else if (Variables == null || Variables.Count == 0)
{
    <p>No hay variables registradas.</p>
}
else if (VariablesFiltradas.Count == 0 && !string.IsNullOrEmpty(TextoBusqueda))
{
    <div class="alert alert-info">
        <i class="fas fa-search"></i> No se encontraron variables que coincidan con "<strong>@TextoBusqueda</strong>"
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>IdVariable</th>
                    <th>IdIndicador</th>
                    <th>Dato</th>
                    <th>Email</th>
                    <th>FechaDato</th>
                    @* Solo los verificadores y validadores no ven las acciones de crear/editar/eliminar *@
                    @if (!EsVerificador && !EsValidador)
                    {
                        <th>Acciones</th>
                    }
                    @* Los validadores solo pueden editar, así que necesitan ver la columna de acciones si solo son validadores y no verificadores *@
                    @if (EsValidador && !EsVerificador)
                    {
                        <th>Acciones</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var variable in VariablesFiltradas)
                {
                    <tr>
                        <td>@ObtenerValor(variable, "fkidvariable")</td>
                        <td>@ObtenerValor(variable, "fkidindicador")</td>
                        <td>@ObtenerValor(variable, "dato")</td>
                        <td>@ObtenerValor(variable, "fkemailusuario")</td>
                        <td>@ObtenerValor(variable, "fechadato")</td>
                        @* Administradores pueden hacer todo *@
                        @if (!EsVerificador && !EsValidador)
                        {
                            <td>
                                <button class="btn btn-warning btn-sm" @onclick="() => MostrarFormularioEditar(variable)">Editar</button>
                                <button class="btn btn-danger btn-sm" @onclick="() => ConfirmarEliminar(variable)">Eliminar</button>
                            </td>
                        }
                        @* Los validadores solo pueden editar *@
                        @if (EsValidador && !EsVerificador)
                        {
                            <td>
                                <button class="btn btn-warning btn-sm" @onclick="() => MostrarFormularioEditar(variable)">Editar</button>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<ModalGenerico @ref="modalFormulario"
               Id="variableFormModal"
               Title="@TituloModal"
               OnSave="GuardarVariable">
    <BodyContent>
        <div class="mb-3">
            <label for="variable" class="form-label">Variable</label>
            <select class="form-select" id="variable" @bind="variableSeleccionada">
                <option value="">Seleccione una variable</option>
                @foreach (var variable in ListaVariables)
                {
                    <option value="@variable.Id">@variable.Nombre</option>
                }
            </select>
        </div>
        <div class="mb-3">
            <label for="indicador" class="form-label">Indicador</label>
            <select class="form-select" id="indicador" @bind="indicadorSeleccionado">
                <option value="">Seleccione un indicador</option>
                @foreach (var indicador in ListaIndicadores)
                {
                    <option value="@indicador.id">@indicador.nombre</option>
                }
            </select>
        </div>
        <div class="mb-3">
            <label for="dato" class="form-label">Dato</label>
            <input type="text" class="form-control" id="dato" @bind="datoSeleccionado" />
        </div>
        <div class="mb-3">
            <label for="email" class="form-label">Email</label>
            <input type="email" class="form-control" id="email" @bind="emailSeleccionado" readonly />
            <small class="form-text text-muted">El email se asigna automáticamente basado en tu sesión actual.</small>
        </div>
        <div class="mb-3">
            <label for="fecha" class="form-label">Fecha del Dato</label>
            <input type="date" class="form-control" id="fecha" @bind="fechaSeleccionada" />
        </div>
    </BodyContent>
</ModalGenerico>

<ModalGenerico @ref="modalConfirmacion"
               Id="confirmModal"
               Title="Confirmar eliminación"
               OnSave="EliminarVariable">
    <BodyContent>
        <p>¿Está seguro que desea eliminar esta variable por indicador?</p>
    </BodyContent>
</ModalGenerico>

@if (!string.IsNullOrEmpty(mensaje))
{
    <div class="alert alert-@tipoAlerta alert-dismissible fade show mt-3" role="alert">
        @mensaje
        <button type="button" class="btn-close" @onclick="LimpiarMensaje"></button>
    </div>
}

@code {
    private const string TABLA = "variablesporindicador";

    // Propiedades para el listado de variables por indicador
    private List<Dictionary<string, object>> Variables { get; set; } = new();
    private List<Dictionary<string, object>> VariablesFiltradas { get; set; } = new(); // New list for filtered data
    private bool EstamosCargando { get; set; } = true;
    private string? mensaje { get; set; }
    private string tipoAlerta { get; set; } = "info";

    // Propiedades para la búsqueda
    private string TextoBusqueda { get; set; } = string.Empty;

    // Propiedades para el formulario
    private int idSeleccionado { get; set; }
    private int variableSeleccionada { get; set; }
    private int indicadorSeleccionado { get; set; }
    private string datoSeleccionado { get; set; } = string.Empty;
    private string emailSeleccionado { get; set; } = string.Empty;
    private DateTime fechaSeleccionada { get; set; } = DateTime.Today;
    private string fechaFormat => fechaSeleccionada.ToString("yyyy-MM-dd");
    private string peticionSeleccionada { get; set; } = "Create";

    // Referencias modales
    private ModalGenerico? modalFormulario;
    private ModalGenerico? modalConfirmacion;
    private string TituloModal => $"{(peticionSeleccionada == "Edit" ? "Editar" : "Crear")} Variable por Indicador";
    private bool EsVerificador { get; set; } = false;
    private bool EsValidador { get; set; } = false; // Added: Declaration of EsValidador

    // Listas para dropdowns
    private List<VariableModel> ListaVariables { get; set; } = new();
    private List<IndicadorModel> ListaIndicadores { get; set; } = new();

    // Nueva propiedad para almacenar el email del usuario logueado
    private string EmailUsuarioLogueado { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var rol = await JSRuntime.InvokeAsync<string>("sessionStorage.getItem", "rolUsuario");
        EsVerificador = RutasPermisosService.EsRolVerificador(rol);
        EsValidador = RutasPermisosService.EsRolValidador(rol); // Added: Initialization of EsValidador
        
        // Obtener el email del usuario logueado desde sessionStorage
        EmailUsuarioLogueado = await JSRuntime.InvokeAsync<string>("sessionStorage.getItem", "usuarioEmail") ?? string.Empty;
        
        await CargarVariables();
        await CargarCatalogos();
    }

    private async Task CargarVariables()
    {
        EstamosCargando = true;
        mensaje = null;

        try
        {
            Variables = await ServicioEntidad.ObtenerTodosAsync(TABLA) ?? new List<Dictionary<string, object>>();
            VariablesFiltradas = new List<Dictionary<string, object>>(Variables); // Initialize filtered list

            // Apply filter if there's existing search text
            if (!string.IsNullOrEmpty(TextoBusqueda))
            {
                FiltrarVariables();
            }
        }
        catch (Exception ex)
        {
            mensaje = $"Error al cargar variables: {ex.Message}";
            tipoAlerta = "danger";
            Variables = new List<Dictionary<string, object>>();
            VariablesFiltradas = new List<Dictionary<string, object>>();
        }
        finally
        {
            EstamosCargando = false;
        }
    }

    private async Task CargarCatalogos()
    {
        try
        {
            var variablesData = await ServicioEntidad.ObtenerTodosAsync("variable");
            var indicadoresData = await ServicioEntidad.ObtenerTodosAsync("indicador");

            ListaVariables = variablesData?.Select(v => new VariableModel
                {
                    Id = Convert.ToInt32(ObtenerValor(v, "id")),
                    Nombre = ObtenerValor(v, "nombre")
                }).ToList() ?? new List<VariableModel>();

            ListaIndicadores = indicadoresData?.Select(i => new IndicadorModel
                {
                    id = ObtenerValor(i, "id"),
                    nombre = ObtenerValor(i, "nombre")
                }).ToList() ?? new List<IndicadorModel>();
        }
        catch (Exception ex)
        {
            mensaje = $"Error al cargar catálogos: {ex.Message}";
            tipoAlerta = "danger";
        }
    }

    private string ObtenerValor(Dictionary<string, object> diccionario, string clave)
    {
        return diccionario.TryGetValue(clave, out var valor) ? valor?.ToString() ?? string.Empty : string.Empty;
    }

    private void FiltrarVariables(ChangeEventArgs? e = null)
    {
        if (e != null)
        {
            TextoBusqueda = e.Value?.ToString() ?? string.Empty;
        }

        if (string.IsNullOrEmpty(TextoBusqueda))
        {
            VariablesFiltradas = new List<Dictionary<string, object>>(Variables);
        }
        else
        {
            var textoBusquedaLower = TextoBusqueda.ToLower().Trim();

            VariablesFiltradas = Variables.Where(variable =>
            {
                var idVariable = ObtenerValor(variable, "fkidvariable").ToLower();
                var idIndicador = ObtenerValor(variable, "fkidindicador").ToLower();
                var dato = ObtenerValor(variable, "dato").ToLower();
                var email = ObtenerValor(variable, "fkemailusuario").ToLower();
                // If you want to search by date, you'll need to parse and format it consistently
                var fechaDato = ObtenerValor(variable, "fechadato").ToLower();

                return idVariable.Contains(textoBusquedaLower) ||
                       idIndicador.Contains(textoBusquedaLower) ||
                       dato.Contains(textoBusquedaLower) ||
                       email.Contains(textoBusquedaLower) ||
                       fechaDato.Contains(textoBusquedaLower); // Simple string contains for date
            }).ToList();
        }

        StateHasChanged(); // Notify Blazor that the state has changed and UI should re-render
    }

    private void LimpiarBusqueda()
    {
        TextoBusqueda = string.Empty;
        VariablesFiltradas = new List<Dictionary<string, object>>(Variables);
        StateHasChanged();
    }

    private async Task MostrarFormularioCrear()
    {
        // Modified: Verifiers and Validators cannot create
        if (EsVerificador || EsValidador)
            return;
        LimpiarFormulario();
        
        // Asignar automáticamente el email del usuario logueado
        emailSeleccionado = EmailUsuarioLogueado;
        
        peticionSeleccionada = "Create";
        await modalFormulario.ShowModalAsync();
    }

    private async Task MostrarFormularioEditar(Dictionary<string, object> variable)
    {
        // Modified: Only verifiers cannot edit (validators can edit)
        if (EsVerificador)
            return;
        LimpiarFormulario();

        idSeleccionado = Convert.ToInt32(ObtenerValor(variable, "id"));
        variableSeleccionada = Convert.ToInt32(ObtenerValor(variable, "fkidvariable"));
        indicadorSeleccionado = Convert.ToInt32(ObtenerValor(variable, "fkidindicador"));
        datoSeleccionado = ObtenerValor(variable, "dato");
        
        // En modo edición, mantener el email original del registro
        emailSeleccionado = ObtenerValor(variable, "fkemailusuario");

        if (DateTime.TryParse(ObtenerValor(variable, "fechadato"), out DateTime fecha))
        {
            fechaSeleccionada = fecha;
        }

        peticionSeleccionada = "Edit";
        await modalFormulario.ShowModalAsync();
    }

    private async Task ConfirmarEliminar(Dictionary<string, object> variable)
    {
        // Modified: Verifiers and Validators cannot delete
        if (EsVerificador || EsValidador)
            return;
        idSeleccionado = Convert.ToInt32(ObtenerValor(variable, "id"));
        await modalConfirmacion.ShowModalAsync();
    }

    private void LimpiarFormulario()
    {
        idSeleccionado = 0;
        variableSeleccionada = 0;
        indicadorSeleccionado = 0;
        datoSeleccionado = string.Empty;
        emailSeleccionado = string.Empty;
        fechaSeleccionada = DateTime.Today;
    }

    private async Task GuardarVariable()
    {
        // Modified: Verifiers and Validators cannot save (validators can only edit)
        if (EsVerificador)
            return;

        if (EsValidador && peticionSeleccionada == "Create") // Validators cannot create
            return;

        if (variableSeleccionada == 0 || indicadorSeleccionado == 0 || string.IsNullOrEmpty(datoSeleccionado))
        {
            mensaje = "Variable, Indicador y Dato son campos obligatorios";
            tipoAlerta = "warning";
            return;
        }

        // Validar que tengamos un email del usuario logueado
        if (string.IsNullOrEmpty(EmailUsuarioLogueado))
        {
            mensaje = "No se pudo obtener el email del usuario logueado. Por favor, inicie sesión nuevamente.";
            tipoAlerta = "danger";
            return;
        }

        var body = new Dictionary<string, object>
        {
            { "fkidvariable", variableSeleccionada },
            { "fkidindicador", indicadorSeleccionado },
            { "dato", datoSeleccionado },
            { "fkemailusuario", peticionSeleccionada == "Create" ? EmailUsuarioLogueado : emailSeleccionado },
            { "fechadato", fechaFormat }
        };

        // You should check the actual response from ServicioEntidad.CrearAsync/ActualizarAsync
        // These methods should return a boolean indicating success or throw an exception on failure.
        // The original code was using a tempRespuesta which was never assigned, leading to issues.
        bool success = false;
        string actionType = string.Empty;

        try
        {
            if (peticionSeleccionada == "Create")
            {
                success = await ServicioEntidad.CrearAsync(TABLA, body);
                actionType = "creado";
            }
            else if (peticionSeleccionada == "Edit")
            {
                success = await ServicioEntidad.ActualizarAsync(TABLA, "id", idSeleccionado.ToString(), body);
                actionType = "actualizado";
            }
            else
            {
                tipoAlerta = "warning";
                mensaje = "Acción no permitida, seleccione una acción válida.";
                return;
            }

            if (success)
            {
                tipoAlerta = "success";
                mensaje = $"Registro {actionType} exitosamente!";
                await CargarVariables(); // Reload data after successful operation
                await modalFormulario.HideModalAsync();
            }
            else
            {
                tipoAlerta = "danger";
                mensaje = $"No se pudo {actionType} el registro.";
            }
        }
        catch (Exception ex)
        {
            tipoAlerta = "danger";
            mensaje = $"Error al guardar el registro: {ex.Message}";
            Console.WriteLine($"Error al guardar el registro: {ex.Message}");
        }
        resetMensaje();
    }

    private async Task EliminarVariable()
    {
        // Modified: Verifiers and Validators cannot delete
        if (EsVerificador || EsValidador)
            return;
        try
        {
            var respuesta = await ServicioEntidad.EliminarAsync(TABLA, "id", idSeleccionado.ToString());

            if (respuesta)
            {
                tipoAlerta = "success";
                mensaje = "Registro Eliminado Exitosamente!";
                await CargarVariables();
                await modalConfirmacion.HideModalAsync();
            }
            else
            {
                tipoAlerta = "danger";
                mensaje = "No se pudo eliminar el registro";
            }
        }
        catch (HttpRequestException ex)
        {
            tipoAlerta = "danger";
            mensaje = $"Error en la petición: {ex.Message}";
            Console.WriteLine($"Error en la petición: {ex.Message}");
        }
        resetMensaje();
    }

    private void LimpiarMensaje()
    {
        mensaje = null;
    }

    private void resetMensaje()
    {
        Task.Delay(5000).ContinueWith(_ =>
        {
            InvokeAsync(() =>
            {
                mensaje = null;
                StateHasChanged();
            });
        });
    }
}