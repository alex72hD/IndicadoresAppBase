@page "/ResponsablePorIndicador"
@using System.Collections.Generic
@using System.Text.Json
@using IndicadoresApp.Clases.IndicadoresApp.Clases
@using IndicadoresApp.ModalGenerico
@inject IJSRuntime JSRuntime
@inject ServicioEntidad ServicioEntidad
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inherits ValidacionAcceso
<PageTitle>Responsables por indicadores</PageTitle>

<h1>Responsables por indicadores</h1>
@* Solo los administradores pueden crear responsables por indicador *@
@if (!EsVerificador && !EsValidador)
{
    <div class="mb-3">
        <button class="btn btn-primary" @onclick="MostrarFormularioCrear">Crear Nuevo</button>
    </div>
}

<div class="mb-3">
    <div class="row">
        <div class="col-md-6">
            <div class="input-group">
                <input type="text"
                class="form-control"
                placeholder="Buscar por responsable, indicador o fecha..."
                @bind="TextoBusqueda"
                @oninput="FiltrarResponsables" />
                <button class="btn btn-outline-secondary" type="button" @onclick="LimpiarBusqueda">
                    <i class="fas fa-times"></i> Limpiar
                </button>
            </div>
        </div>
        <div class="col-md-6">
            <small class="text-muted">
                Mostrando @ResponsablesFiltrados.Count de @Responsables.Count asignaciones
            </small>
        </div>
    </div>
</div>

@if (EstamosCargando)
{
    <p><em>Cargando...</em></p>
}
else if (Responsables == null || Responsables.Count == 0)
{
    <p>No hay responsables asignados a indicadores.</p>
}
else if (ResponsablesFiltrados.Count == 0 && !string.IsNullOrEmpty(TextoBusqueda))
{
    <div class="alert alert-info">
        <i class="fas fa-search"></i> No se encontraron asignaciones que coincidan con "<strong>@TextoBusqueda</strong>"
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>ID Responsable</th>
                    <th>Responsable</th>
                    <th>ID Indicador</th>
                    <th>Indicador</th>
                    <th>Fecha de Asignación</th>
                    @* Mostrar acciones solo si no es verificador o validador *@
                    @if (!EsVerificador && !EsValidador)
                    {
                        <th>Acciones</th>
                    }
                    @* Los validadores solo pueden editar, así que necesitan ver la columna de acciones si solo son validadores y no verificadores *@
                    @if (EsValidador && !EsVerificador)
                    {
                        <th>Acciones</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var responsable in ResponsablesFiltrados)
                {
                    <tr>
                        <td>@ObtenerValor(responsable, "fkidresponsable")</td>
                        <td>@ObtenerNombreResponsable(ObtenerValor(responsable, "fkidresponsable"))</td>
                        <td>@ObtenerValor(responsable, "fkidindicador")</td>
                        <td>@ObtenerNombreIndicador(ObtenerValor(responsable, "fkidindicador"))</td>
                        <td>@ObtenerValor(responsable, "fechaasignacion")</td>
                        @* Administradores pueden hacer todo *@
                        @if (!EsVerificador && !EsValidador)
                        {
                            <td>
                                <button class="btn btn-warning btn-sm" @onclick="() => MostrarFormularioEditar(responsable)">Editar</button>
                                <button class="btn btn-danger btn-sm" @onclick="() => ConfirmarEliminar(responsable)">Eliminar</button>
                            </td>
                        }
                        @* Los validadores solo pueden editar *@
                        @if (EsValidador && !EsVerificador)
                        {
                            <td>
                                <button class="btn btn-warning btn-sm" @onclick="() => MostrarFormularioEditar(responsable)">Editar</button>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<ModalGenerico @ref="modalFormulario"
Id="formModal"
Title="@TituloModal"
OnSave="GuardarResponsable">
    <BodyContent>
        <div class="mb-3">
            <label for="idResponsable" class="form-label">Responsable</label>
            <select class="form-select" id="idResponsable" @bind="ResponsableActual.IdResponsable">
                <option value="0">Seleccione un responsable</option>
                @if (ResponsablesDisponibles != null)
                {
                    @foreach (var responsable in ResponsablesDisponibles)
                    {
                        <option value="@responsable.Id">@responsable.Nombre</option>
                    }
                }
            </select>
        </div>
        <div class="mb-3">
            <label for="idIndicador" class="form-label">Indicador</label>
            <select class="form-select" id="idIndicador" @bind="ResponsableActual.IdIndicador">
                <option value="0">Seleccione un indicador</option>
                @if (IndicadoresDisponibles != null)
                {
                    @foreach (var indicador in IndicadoresDisponibles)
                    {
                        <option value="@indicador.Id">@indicador.Nombre</option>
                    }
                }
            </select>
        </div>
        <div class="mb-3">
            <label for="fechaAsignacion" class="form-label">Fecha de Asignación</label>
            <input type="date" class="form-control" id="fechaAsignacion"
            @bind="ResponsableActual.FechaAsignacion"
            @bind:format="yyyy-MM-dd" />
        </div>
        @if (ModoEdicion)
        {
            <input type="hidden" @bind="ResponsableOriginal.IdResponsable" />
            <input type="hidden" @bind="ResponsableOriginal.IdIndicador" />
        }
    </BodyContent>
</ModalGenerico>

<ModalGenerico @ref="modalConfirmacion"
Id="confirmModal"
Title="Confirmar eliminación"
OnSave="EliminarResponsable">
    <BodyContent>
        <p>
            ¿Está seguro que desea eliminar la asignación del responsable
            @ObtenerNombreResponsable(ResponsableAEliminar.IdResponsable.ToString()) al indicador
            @ObtenerNombreIndicador(ResponsableAEliminar.IdIndicador.ToString())?
        </p>
    </BodyContent>
</ModalGenerico>

@if (!string.IsNullOrEmpty(MensajeError))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>Error:</strong> @MensajeError
        <button type="button" class="btn-close" @onclick="() => MensajeError = null" aria-label="Close"></button>
    </div>
}

@if (!string.IsNullOrEmpty(MensajeExito))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @MensajeExito
        <button type="button" class="btn-close" @onclick="() => MensajeExito = null" aria-label="Close"></button>
    </div>
}

@code {
    private const string NOMBRE_TABLA = "responsablesporindicador";
    private const string TABLA_INDICADORES = "indicador";
    private const string TABLA_RESPONSABLES = "actor";
    private const string PROCEDIMIENTO_ACCIONES = "accion_responsable_por_indicador";
    private bool EsVerificador { get; set; } = false;
    private bool EsValidador { get; set; } = false; // Added: Declaration of EsValidador
    private List<Dictionary<string, object>> Responsables { get; set; } = new();
    private List<Dictionary<string, object>> ResponsablesFiltrados { get; set; } = new(); // New list for filtered data
    private bool EstamosCargando { get; set; } = true;
    private string? MensajeError { get; set; }
    private string? MensajeExito { get; set; }

    // Propiedad para la búsqueda
    private string TextoBusqueda { get; set; } = string.Empty;

    private bool ModoEdicion { get; set; } = false;
    private ResponsableModel ResponsableActual { get; set; } = new();
    private ResponsableModel ResponsableOriginal { get; set; } = new(); // Para guardar el estado inicial en edición
    private ModalGenerico? modalFormulario;
    private string TituloModal => $"{(ModoEdicion ? "Editar" : "Crear")} Asignación de Responsable";

    private ResponsableModel ResponsableAEliminar { get; set; } = new();
    private ModalGenerico? modalConfirmacion;

    // Datos para los selectores
    private List<ItemSelectModel> IndicadoresDisponibles { get; set; } = new();
    private List<ItemSelectModel> ResponsablesDisponibles { get; set; } = new();

    // Para identificación única de relaciones
    private string? IdAsignacionSeleccionada { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var rol = await JSRuntime.InvokeAsync<string>("sessionStorage.getItem", "rolUsuario");
        EsVerificador = RutasPermisosService.EsRolVerificador(rol);
        EsValidador = RutasPermisosService.EsRolValidador(rol); // Added: Initialization of EsValidador
        await CargarDatosIniciales();
    }

    private async Task CargarDatosIniciales()
    {
        try
        {
            // Cargar los indicadores y responsables para tener la referencia
            await CargarIndicadores();
            await CargarResponsables();
            // Luego cargar las relaciones
            await CargarAsignaciones();
        }
        catch (Exception ex)
        {
            MensajeError = $"Error cargando datos iniciales: {ex.Message}";
        }
    }

    private async Task CargarAsignaciones()
    {
        EstamosCargando = true;
        MensajeError = null;

        try
        {
            Responsables = await ServicioEntidad.ObtenerTodosAsync(NOMBRE_TABLA) ?? new List<Dictionary<string, object>>();
            ResponsablesFiltrados = new List<Dictionary<string, object>>(Responsables); // Initialize filtered list

            // Apply filter if there's existing search text
            if (!string.IsNullOrEmpty(TextoBusqueda))
            {
                FiltrarResponsables();
            }
        }
        catch (Exception ex)
        {
            MensajeError = $"Error al cargar asignaciones: {ex.Message}";
            Console.WriteLine($"Excepción al cargar asignaciones: {ex}");
            Responsables = new List<Dictionary<string, object>>();
            ResponsablesFiltrados = new List<Dictionary<string, object>>();
        }
        finally
        {
            EstamosCargando = false;
            StateHasChanged(); // Force UI update
        }
    }

    private async Task CargarIndicadores()
    {
        try
        {
            var resultado = await ServicioEntidad.ObtenerTodosAsync(TABLA_INDICADORES);
            IndicadoresDisponibles = resultado
                .Select(i => new ItemSelectModel
                    {
                        Id = Convert.ToInt32(ObtenerValor(i, "id")),
                        Nombre = ObtenerValor(i, "nombre")
                    })
                .OrderBy(i => i.Nombre)
                .ToList();
        }
        catch (Exception ex)
        {
            MensajeError = $"Error cargando indicadores: {ex.Message}";
            Console.WriteLine($"Excepción al cargar indicadores: {ex}");
        }
    }

    private async Task CargarResponsables()
    {
        try
        {
            var resultado = await ServicioEntidad.ObtenerTodosAsync(TABLA_RESPONSABLES);
            ResponsablesDisponibles = resultado
                .Select(r => new ItemSelectModel
                    {
                        Id = Convert.ToInt32(ObtenerValor(r, "id")),
                        Nombre = ObtenerValor(r, "nombre")
                    })
                .OrderBy(r => r.Nombre)
                .ToList();
        }
        catch (Exception ex)
        {
            MensajeError = $"Error cargando responsables: {ex.Message}";
            Console.WriteLine($"Excepción al cargar responsables: {ex}");
        }
    }

    private string ObtenerNombreIndicador(string id)
    {
        if (string.IsNullOrEmpty(id) || !int.TryParse(id, out int idNumerico))
        {
            return "No asignado";
        }

        var indicador = IndicadoresDisponibles.FirstOrDefault(i => i.Id == idNumerico);
        return indicador?.Nombre ?? "Desconocido";
    }

    private string ObtenerNombreResponsable(string id)
    {
        if (string.IsNullOrEmpty(id) || !int.TryParse(id, out int idNumerico))
        {
            return "No asignado";
        }

        var responsable = ResponsablesDisponibles.FirstOrDefault(r => r.Id == idNumerico);
        return responsable?.Nombre ?? "Desconocido";
    }

    private string ObtenerValor(Dictionary<string, object> diccionario, string clave)
    {
        if (diccionario == null)
        {
            return string.Empty;
        }

        if (diccionario.TryGetValue(clave, out var valor))
        {
            return valor?.ToString() ?? string.Empty;
        }
        else
        {
            return string.Empty;
        }
    }

    private void FiltrarResponsables(ChangeEventArgs? e = null)
    {
        if (e != null)
        {
            TextoBusqueda = e.Value?.ToString() ?? string.Empty;
        }

        if (string.IsNullOrEmpty(TextoBusqueda))
        {
            ResponsablesFiltrados = new List<Dictionary<string, object>>(Responsables);
        }
        else
        {
            var textoBusquedaLower = TextoBusqueda.ToLower().Trim();

            ResponsablesFiltrados = Responsables.Where(r =>
            {
                var nombreResponsable = ObtenerNombreResponsable(ObtenerValor(r, "fkidresponsable")).ToLower();
                var nombreIndicador = ObtenerNombreIndicador(ObtenerValor(r, "fkidindicador")).ToLower();
                var fechaAsignacion = ObtenerValor(r, "fechaasignacion").ToLower();

                return nombreResponsable.Contains(textoBusquedaLower) ||
                       nombreIndicador.Contains(textoBusquedaLower) ||
                       fechaAsignacion.Contains(textoBusquedaLower);
            }).ToList();
        }

        StateHasChanged(); // Notify Blazor that the state has changed and UI should re-render
    }

    private void LimpiarBusqueda()
    {
        TextoBusqueda = string.Empty;
        ResponsablesFiltrados = new List<Dictionary<string, object>>(Responsables);
        StateHasChanged();
    }

    private async Task MostrarFormularioCrear()
    {
        // Modified: Verifiers and Validators cannot create
        if (EsVerificador || EsValidador)
            return;
        ResponsableActual = new ResponsableModel
            {
                FechaAsignacion = DateTime.Today // Establecer fecha actual por defecto
            };
        ResponsableOriginal = new ResponsableModel();
        ModoEdicion = false;
        await modalFormulario.ShowModalAsync();
    }

    private async Task MostrarFormularioEditar(Dictionary<string, object> responsable)
    {
        // Modified: Only verifiers cannot edit (validators can edit)
        if (EsVerificador)
            return;
        try
        {
            // Almacenar los valores originales para saber qué eliminar
            ResponsableOriginal = new ResponsableModel
                {
                    IdResponsable = Convert.ToInt32(ObtenerValor(responsable, "fkidresponsable")),
                    IdIndicador = Convert.ToInt32(ObtenerValor(responsable, "fkidindicador"))
                };

            // Intentar parsear la fecha
            if (DateTime.TryParse(ObtenerValor(responsable, "fechaasignacion"), out DateTime fechaAsignacion))
            {
                ResponsableOriginal.FechaAsignacion = fechaAsignacion;
            }
            else
            {
                ResponsableOriginal.FechaAsignacion = DateTime.Today;
            }

            // Establecer los valores actuales para la edición (copia)
            ResponsableActual = new ResponsableModel
                {
                    IdResponsable = ResponsableOriginal.IdResponsable,
                    IdIndicador = ResponsableOriginal.IdIndicador,
                    FechaAsignacion = ResponsableOriginal.FechaAsignacion
                };

            // Verificar si hay un ID de relación disponible
            IdAsignacionSeleccionada = ObtenerValor(responsable, "id");

            ModoEdicion = true;
            await modalFormulario.ShowModalAsync();
        }
        catch (Exception ex)
        {
            MensajeError = $"Error al cargar datos para edición: {ex.Message}";
            Console.WriteLine($"Excepción al cargar datos para edición: {ex}");
        }
    }

    private async Task ConfirmarEliminar(Dictionary<string, object> responsable)
    {
        // Modified: Verifiers and Validators cannot delete
        if (EsVerificador || EsValidador)
            return;
        try
        {
            ResponsableAEliminar = new ResponsableModel
                {
                    IdResponsable = Convert.ToInt32(ObtenerValor(responsable, "fkidresponsable")),
                    IdIndicador = Convert.ToInt32(ObtenerValor(responsable, "fkidindicador"))
                };

            // Intentar parsear la fecha
            if (DateTime.TryParse(ObtenerValor(responsable, "fechaasignacion"), out DateTime fechaAsignacion))
            {
                ResponsableAEliminar.FechaAsignacion = fechaAsignacion;
            }

            // Verificar si hay un ID de relación disponible
            IdAsignacionSeleccionada = ObtenerValor(responsable, "id");

            await modalConfirmacion.ShowModalAsync();
        }
        catch (Exception ex)
        {
            MensajeError = $"Error al preparar eliminación: {ex.Message}";
        }
    }

    private async Task GuardarResponsable()
    {
        // Modified: Verifiers cannot save (create or edit)
        if (EsVerificador)
            return;

        // Added: Validators cannot create, only edit
        if (EsValidador && !ModoEdicion)
            return;

        MensajeError = null;
        MensajeExito = null;

        try
        {
            // Validaciones
            if (ResponsableActual.IdResponsable <= 0)
            {
                MensajeError = "Debe seleccionar un responsable.";
                return;
            }

            if (ResponsableActual.IdIndicador <= 0)
            {
                MensajeError = "Debe seleccionar un indicador.";
                return;
            }

            // Crear el diccionario con los campos correctos para la API
            var responsableData = new Dictionary<string, object>
                {
                    ["fkidresponsable"] = ResponsableActual.IdResponsable,
                    ["fkidindicador"] = ResponsableActual.IdIndicador,
                    ["fechaasignacion"] = ResponsableActual.FechaAsignacion.ToString("yyyy-MM-dd")
                };

            bool resultado = false; // Initialize to false

            if (ModoEdicion)
            {
                responsableData["accion"] = "edit";
                responsableData["indicadorInicial"] = ResponsableOriginal.IdIndicador;
                responsableData["responsableInicial"] = ResponsableOriginal.IdResponsable;

                // Assuming ServicioEntidad.EjecutarProcedimientoAsync returns a boolean or has an out parameter for success
                var respuesta = await ServicioEntidad.EjecutarProcedimientoAsync(
                    "tbl",
                    PROCEDIMIENTO_ACCIONES,
                    responsableData
                );
                try
                {
                    resultado = Convert.ToBoolean(respuesta);
                }
                catch
                {
                    resultado = false; // valor por defecto si la conversión falla
                }
                if (resultado)
                {
                    MensajeExito = "Asignación de responsable actualizada correctamente.";
                }
                else
                {
                    MensajeError = "No se pudo actualizar la asignación de responsable.";
                    return;
                }
            }
            else
            {
                // Para la creación
                responsableData["accion"] = "create";
                responsableData["indicadorInicial"] = 0; // Not used for creation, but procedure might expect it
                responsableData["responsableInicial"] = 0; // Not used for creation, but procedure might expect it

                var respuesta = await ServicioEntidad.EjecutarProcedimientoAsync(
                    "tbl",
                    PROCEDIMIENTO_ACCIONES,
                    responsableData
                );
                try
                {
                    resultado = Convert.ToBoolean(respuesta);
                }
                catch
                {
                    resultado = false; 
                }

                if (resultado)
                {
                    MensajeExito = "Asignación de responsable creada correctamente.";
                }
                else
                {
                    MensajeError = "No se pudo crear la asignación de responsable.";
                    return;
                }
            }

            if (resultado)
            {
                await CargarAsignaciones();
                await modalFormulario.HideModalAsync();
            }
        }
        catch (Exception ex)
        {
            MensajeError = $"Error: {ex.Message}";
            Console.WriteLine($"Excepción al guardar asignación: {ex}");
        }
    }

    private async Task EliminarResponsable()
    {
        // Modified: Verifiers and Validators cannot delete
        if (EsVerificador || EsValidador)
            return;
        MensajeError = null;
        MensajeExito = null;

        try
        {
            var body = new Dictionary<string, object>
                {
                    { "fkidindicador", ResponsableAEliminar.IdIndicador },
                    { "fkidresponsable", ResponsableAEliminar.IdResponsable },
                    { "accion", "delete" },
                    { "indicadorInicial", 0 }, // Not directly used for delete by PK, but procedure might expect it
                    { "responsableInicial", 0 } // Not directly used for delete by PK, but procedure might expect it
                };

            var respuesta = await ServicioEntidad.EjecutarProcedimientoAsync(
                "tbl",
                PROCEDIMIENTO_ACCIONES,
                body
            );
            // Assuming 'respuesta' indicates success or failure
            var resultado = false;
            try
            {
               resultado = Convert.ToBoolean(respuesta);
            }
            catch
            {
              resultado = false; // valor por defecto si la conversión falla
            }; // Cast based on actual return type

            if (resultado)
            {
                MensajeExito = "Asignación eliminada correctamente.";
                await CargarAsignaciones();
            }
            else
            {
                MensajeError = "No se pudo eliminar la asignación.";
            }

            await modalConfirmacion.HideModalAsync();
        }
        catch (Exception ex)
        {
            MensajeError = $"Error en la petición: {ex.Message}";
            Console.WriteLine($"Error al eliminar registro: {ex}");
        }
    }

    // Método auxiliar para reiniciar los mensajes después de un tiempo
    private async Task ResetMensajes(int milisegundos = 5000)
    {
        await Task.Delay(milisegundos);
        MensajeExito = null;
        MensajeError = null;
        StateHasChanged();
    }

    // Modelos de datos

    private class ItemSelectModel
    {
        public int Id { get; set; }
        public string Nombre { get; set; } = string.Empty;
    }
}