        );

        if (resultado != null)
        {
            mensajeModal = "Responsable eliminado correctamente.";
            await ObtenerRelacionesResponsables(indicadorSeleccionado["id"].ToString());
        }
        else
        {
            mensajeModal = "Error al eliminar el responsable.";
        }
    }

    private string FormatFecha(object fechaObj)
    {
        if (fechaObj == null) return string.Empty;
        if (DateTime.TryParse(fechaObj.ToString(), out DateTime fecha))
        {
            return fecha.ToShortDateString();
        }
        return string.Empty;
    }

