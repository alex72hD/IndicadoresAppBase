    private string BuscarNombre(List<Dictionary<string, object>> lista, object id)
    {
        return lista.FirstOrDefault(item => item["id"].ToString() == id.ToString())?["nombre"]?.ToString() ?? "N/A";
    }

    private string BuscarDescripcion(List<Dictionary<string, object>> lista, object id)
    {
        return lista.FirstOrDefault(item => item["id"].ToString() == id.ToString())?["descripcion"]?.ToString() ?? "N/A";
    }

    private async Task AbrirModalResponsables(Dictionary<string, object> indicador)
    {
        indicadorSeleccionado = indicador;
        mensajeModal = string.Empty;
        nuevoResponsable = string.Empty;
        nuevaFechaAsignacion = DateTime.Today;
        await ObtenerRelacionesResponsables(indicador["id"].ToString());
        await modalResponsables.ShowModalAsync();
    }

    private async Task ObtenerRelacionesResponsables(string indicadorId)
    {
        try
        {
            var todasLasRelaciones = await servicioEntidad.ObtenerTodosAsync(TABLA_RESPONSABLES) ?? new();
            relaciones = todasLasRelaciones
              .Where(r => r["fkidindicador"].ToString() == indicadorId)
              .ToList();
        }
        catch (Exception ex)
        {
            mensajeModal = $"Error al cargar relaciones: {ex.Message}";
        }
    }

    private async Task CrearRelacion()
    {
        mensajeModal = string.Empty;
        if (indicadorSeleccionado == null || string.IsNullOrWhiteSpace(nuevoResponsable))
        {
            mensajeModal = "Debe seleccionar un responsable.";
            return;
        }

        if (relaciones.Any(r =>
          r["fkidresponsable"].ToString() == nuevoResponsable &&
          r["fkidindicador"].ToString() == indicadorSeleccionado["id"].ToString()))
        {
            mensajeModal = "La relación ya existe.";
            return;
        }

        var parametros = new Dictionary<string, object>
    {
      { "nombreSP", "insertar_responsablesporindicador" },
      { "fkidresponsable", int.Parse(nuevoResponsable) },
      { "fkidindicador", int.Parse(indicadorSeleccionado["id"].ToString()) },
      { "fechaasignacion", nuevaFechaAsignacion.ToString("yyyy-MM-dd") }
    };

        var resultado = await servicioEntidad.EjecutarProcedimientoAsync(
          TABLA_RESPONSABLES,
          "insertar_responsablesporindicador",
          parametros
        );

        if (resultado != null)
        {
            mensajeModal = "Responsable asignado correctamente.";
            nuevoResponsable = string.Empty;
            await ObtenerRelacionesResponsables(indicadorSeleccionado["id"].ToString());
        }
        else
        {
            mensajeModal = "Error al asignar responsable.";
        }
    }

    private async Task EliminarRelacion(Dictionary<string, object> relacion)
    {
        bool confirmar = await JSRuntime.InvokeAsync<bool>("confirm",
          $"¿Desea eliminar este responsable del indicador?");
