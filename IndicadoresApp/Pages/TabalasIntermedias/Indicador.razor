    private void IniciarEdicion(Dictionary<string, object> indicador)
    {
        indicadorEditarId = indicador["id"].ToString();
        indicadorEditarCodigo = indicador["codigo"].ToString();
        indicadorEditarNombre = indicador["nombre"].ToString();
        indicadorEditarMeta = indicador["meta"].ToString();
        indicadorEditarObjetivo = indicador["objetivo"].ToString();
        indicadorEditarAlcance = indicador["alcance"].ToString();
        indicadorEditarFormula = indicador["formula"].ToString();
        indicadorEditarTipo = indicador["fkidtipoindicador"].ToString();
        indicadorEditarUnidad = indicador["fkidunidadmedicion"].ToString();
        indicadorEditarSentido = indicador["fkidsentido"].ToString();
        indicadorEditarFrecuencia = indicador["fkidfrecuencia"].ToString();
        indicadorEditarArticulo = indicador["fkidarticulo"]?.ToString() ?? string.Empty;
        indicadorEditarLiteral = indicador["fkidliteral"]?.ToString() ?? string.Empty;
        indicadorEditarNumeral = indicador["fkidnumeral"]?.ToString() ?? string.Empty;
        indicadorEditarParagrafo = indicador["fkidparagrafo"]?.ToString() ?? string.Empty;
    }

    private async Task GuardarEdicion()
    {
        if (string.IsNullOrWhiteSpace(indicadorEditarCodigo) || string.IsNullOrWhiteSpace(indicadorEditarNombre))
        {
            mensaje = "Código y nombre son obligatorios.";
            return;
        }

        var parametros = new Dictionary<string, object>
    {
      { "nombreSP", "actualizar_indicador" },
      { "id", int.Parse(indicadorEditarId) },
      { "codigo", indicadorEditarCodigo },
      { "nombre", indicadorEditarNombre },
      { "meta", indicadorEditarMeta },
      { "objetivo", indicadorEditarObjetivo },
      { "alcance", indicadorEditarAlcance },
      { "formula", indicadorEditarFormula },
      { "fkidtipoindicador", int.Parse(indicadorEditarTipo) },
      { "fkidunidadmedicion", int.Parse(indicadorEditarUnidad) },
      { "fkidsentido", int.Parse(indicadorEditarSentido) },
      { "fkidfrecuencia", int.Parse(indicadorEditarFrecuencia) },
      { "fkidarticulo", int.Parse(indicadorEditarArticulo) },
      { "fkidliteral", int.Parse(indicadorEditarLiteral) },
      { "fkidnumeral", int.Parse(indicadorEditarNumeral) },
      { "fkidparagrafo", int.Parse(indicadorEditarParagrafo) }
    };

        var resultado = await servicioEntidad.EjecutarProcedimientoAsync(
          TABLA,
          "actualizar_indicador",
          parametros
        );

        if (resultado != null)
        {
            mensaje = "Indicador actualizado correctamente.";
            await ObtenerIndicadores();
            CancelarEdicion();
        }
        else
        {
            mensaje = "Error al actualizar el indicador.";
        }
    }

    private void CancelarEdicion()
    {
        indicadorEditarId = "";
        mensaje = string.Empty;
    }

