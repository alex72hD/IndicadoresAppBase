        var parametros = new Dictionary<string, object>
    {
      { "nombreSP", "eliminar_responsablesporindicador" },
      { "fkidresponsable", int.Parse(relacion["fkidresponsable"].ToString()) },
      { "fkidindicador", int.Parse(relacion["fkidindicador"].ToString()) }
    };

