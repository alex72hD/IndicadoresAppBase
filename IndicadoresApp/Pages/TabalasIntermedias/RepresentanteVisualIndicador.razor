@page "/RepresentanteVisuales"
@using System.Collections.Generic
@using System.Text.Json
@using IndicadoresApp.Clases.IndicadoresApp.Clases
@using IndicadoresApp.ModalGenerico
@inject ServicioEntidad ServicioEntidad
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inherits ValidacionAcceso
<PageTitle>RepresentanteVisuales</PageTitle>

<h1>RepresentanteVisuales</h1>
@* Only administrators can create new visual representatives *@
@if (!EsVerificador && !EsValidador)
{
    <div class="mb-3">
        <button class="btn btn-primary" @onclick="MostrarFormularioCrear">Crear Nuevo</button>
    </div>
}

<div class="mb-3">
    <div class="row">
        <div class="col-md-6">
            <div class="input-group">
                <input type="text"
                       class="form-control"
                       placeholder="Buscar por indicador o representante visual..."
                       @bind="TextoBusqueda"
                       @oninput="FiltrarRepresentantes" />
                <button class="btn btn-outline-secondary" type="button" @onclick="LimpiarBusqueda">
                    <i class="fas fa-times"></i> Limpiar
                </button>
            </div>
        </div>
        <div class="col-md-6">
            <small class="text-muted">
                Mostrando @RepresentantesFiltrados.Count de @Representantes.Count relaciones
            </small>
        </div>
    </div>
</div>


@if (EstamosCargando)
{
    <p><em>Cargando...</em></p>
}
else if (Representantes == null || Representantes.Count == 0)
{
    <p>No hay Representantes registrados.</p>
}
else if (RepresentantesFiltrados.Count == 0 && !string.IsNullOrEmpty(TextoBusqueda))
{
    <div class="alert alert-info">
        <i class="fas fa-search"></i> No se encontraron relaciones que coincidan con "<strong>@TextoBusqueda</strong>"
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>ID Indicador</th>
                    <th>Indicador</th>
                    <th>ID Representante Visual</th>
                    <th>Representante Visual</th>
                    @* Show actions only if not a verifier or validator *@
                    @if (!EsVerificador && !EsValidador)
                    {
                        <th>Acciones</th>
                    }
                    @* Validators can only edit, so they need to see the actions column if they are only validators and not verifiers *@
                    @if (EsValidador && !EsVerificador)
                    {
                        <th>Acciones</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var relacion in RepresentantesFiltrados)
                {
                    <tr>
                        <td>@ObtenerValor(relacion, "fkidindicador")</td>
                        <td>@ObtenerNombreIndicador(ObtenerValor(relacion, "fkidindicador"))</td>
                        <td>@ObtenerValor(relacion, "fkidrepresenvisual")</td>
                        <td>@ObtenerNombreRepresentante(ObtenerValor(relacion, "fkidrepresenvisual"))</td>
                        @* Administrators can do everything *@
                        @if (!EsVerificador && !EsValidador)
                        {
                            <td>
                                <button class="btn btn-warning btn-sm" @onclick="() => MostrarFormularioEditar(relacion)">Editar</button>
                                <button class="btn btn-danger btn-sm" @onclick="() => ConfirmarEliminar(relacion)">Eliminar</button>
                            </td>
                        }
                        @* Validators can only edit *@
                        @if (EsValidador && !EsVerificador)
                        {
                            <td>
                                <button class="btn btn-warning btn-sm" @onclick="() => MostrarFormularioEditar(relacion)">Editar</button>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<ModalGenerico @ref="modalFormulario"
               Id="formModal"
               Title="@TituloModal"
               OnSave="GuardarRelacion"
               ShowSaveButton="true">
    @* Changed to true for save button *@
    <BodyContent>
        <div class="mb-3">
            <label for="idIndicador" class="form-label">Indicador</label>
            <select class="form-select" id="idIndicador" @bind="RelacionActual.IdIndicador">
                <option value="0">Seleccione un indicador</option>
                @foreach (var indicador in IndicadoresDisponibles)
                {
                    <option value="@indicador.Id">@indicador.Nombre</option>
                }
            </select>
        </div>
        <div class="mb-3">
            <label for="idRepresentante" class="form-label">Representante Visual</label>
            <select class="form-select" id="idRepresentante" @bind="RelacionActual.IdRepresentanteVisual">
                <option value="0">Seleccione un representante visual</option>
                @foreach (var representante in RepresentantesDisponibles)
                {
                    <option value="@representante.Id">@representante.Nombre</option>
                }
            </select>
        </div>
    </BodyContent>
</ModalGenerico>

<ModalGenerico @ref="modalConfirmacion"
               Id="confirmModal"
               Title="Confirmar eliminación"
               OnSave="EliminarRelacion"
               ShowSaveButton="true">
    @* Changed to true for save button *@
    <BodyContent>
        <p>¿Está seguro que desea eliminar esta relación?</p>
        <ul>
            <li>Indicador: @ObtenerNombreIndicador(RelacionAEliminar.IdIndicador.ToString())</li>
            <li>Representante Visual: @ObtenerNombreRepresentante(RelacionAEliminar.IdRepresentanteVisual.ToString())</li>
        </ul>
    </BodyContent>
</ModalGenerico>

@if (!string.IsNullOrEmpty(MensajeError))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @* Added dismissible for closer button *@
        @MensajeError
        <button type="button" class="btn-close" @onclick="LimpiarMensajes" aria-label="Close"></button> @* Removed float-end as btn-close handles it *@
    </div>
}

@if (!string.IsNullOrEmpty(MensajeExito))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @* Added dismissible for closer button *@
        @MensajeExito
        <button type="button" class="btn-close" @onclick="LimpiarMensajes" aria-label="Close"></button> @* Removed float-end as btn-close handles it *@
    </div>
}

@code {
    private const string NOMBRE_TABLA = "represenvisualporindicador";
    private const string TABLA_INDICADORES = "indicador";
    private const string TABLA_REPRESENTANTES = "represenvisual";
    private const string PROCEDIMIENTO_ACCIONES = "accion_reprevisual_por_indicador"; // Define the stored procedure name

    private bool EsVerificador { get; set; } = false;
    private bool EsValidador { get; set; } = false; // Added: Declaration of EsValidador
    private List<Dictionary<string, object>> Representantes { get; set; } = new();
    private List<Dictionary<string, object>> RepresentantesFiltrados { get; set; } = new(); // New list for filtered data
    private bool EstamosCargando { get; set; } = true;
    private string? MensajeError { get; set; } // Make nullable for consistent behavior
    private string? MensajeExito { get; set; } // Make nullable for consistent behavior

    // Propiedad para la búsqueda
    private string TextoBusqueda { get; set; } = string.Empty;

    private bool ModoEdicion { get; set; } = false;
    private RelacionModel RelacionActual { get; set; } = new();
    private RelacionModel RelacionOriginal { get; set; } = new(); // Para guardar el estado inicial en edición
    private ModalGenerico? modalFormulario; // Make nullable for consistent behavior
    private string TituloModal => ModoEdicion ? "Editar Relación" : "Nueva Relación";

    private RelacionModel RelacionAEliminar { get; set; } = new();
    private ModalGenerico? modalConfirmacion; // Make nullable for consistent behavior

    private List<ItemSelectModel> IndicadoresDisponibles { get; set; } = new();
    private List<ItemSelectModel> RepresentantesDisponibles { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        var rol = await JSRuntime.InvokeAsync<string>("sessionStorage.getItem", "rolUsuario");
        EsVerificador = RutasPermisosService.EsRolVerificador(rol);
        EsValidador = RutasPermisosService.EsRolValidador(rol); // Added: Initialization of EsValidador
        await CargarDatosIniciales();
    }

    private async Task CargarDatosIniciales()
    {
        try
        {
            await Task.WhenAll(CargarIndicadores(), CargarRepresentantes());
            await CargarRelaciones();
        }
        catch (Exception ex)
        {
            MostrarError($"Error inicial: {ex.Message}");
        }
    }

    private async Task CargarRelaciones()
    {
        try
        {
            EstamosCargando = true;
            Representantes = await ServicioEntidad.ObtenerTodosAsync(NOMBRE_TABLA) ?? new();
            RepresentantesFiltrados = new List<Dictionary<string, object>>(Representantes); // Initialize filtered list

            // Apply filter if there's existing search text
            if (!string.IsNullOrEmpty(TextoBusqueda))
            {
                FiltrarRepresentantes();
            }
        }
        catch (Exception ex)
        {
            MostrarError($"Error cargando relaciones: {ex.Message}");
            Representantes = new List<Dictionary<string, object>>();
            RepresentantesFiltrados = new List<Dictionary<string, object>>();
        }
        finally
        {
            EstamosCargando = false;
            StateHasChanged();
        }
    }

    private async Task CargarIndicadores()
    {
        try
        {
            var data = await ServicioEntidad.ObtenerTodosAsync(TABLA_INDICADORES);
            IndicadoresDisponibles = ConvertirAItemSelect(data, "nombre");
        }
        catch (Exception ex)
        {
            MostrarError($"Error cargando indicadores: {ex.Message}");
        }
    }

    private async Task CargarRepresentantes()
    {
        try
        {
            var data = await ServicioEntidad.ObtenerTodosAsync(TABLA_REPRESENTANTES);
            RepresentantesDisponibles = ConvertirAItemSelect(data, "nombre");
        }
        catch (Exception ex)
        {
            MostrarError($"Error cargando representantes: {ex.Message}");
        }
    }

    private List<ItemSelectModel> ConvertirAItemSelect(List<Dictionary<string, object>> datos, string campoNombre)
    {
        return datos.Select(item => new ItemSelectModel
            {
                Id = Convert.ToInt32(ObtenerValor(item, "id")),
                Nombre = ObtenerValor(item, campoNombre)
            })
            .OrderBy(i => i.Nombre) // Order alphabetically
            .ToList();
    }

    private string ObtenerValor(Dictionary<string, object> diccionario, string clave)
    {
        return diccionario.TryGetValue(clave, out var valor) ? valor?.ToString() ?? string.Empty : string.Empty; // Added null-coalescing and string.Empty
    }

    private string ObtenerNombreIndicador(string id) =>
        BuscarNombre(IndicadoresDisponibles, id);

    private string ObtenerNombreRepresentante(string id) =>
        BuscarNombre(RepresentantesDisponibles, id);

    private string BuscarNombre(List<ItemSelectModel> lista, string id)
    {
        if (!int.TryParse(id, out int idNum)) return "N/A";
        return lista.FirstOrDefault(i => i.Id == idNum)?.Nombre ?? "N/A";
    }

    private void FiltrarRepresentantes(ChangeEventArgs? e = null)
    {
        if (e != null)
        {
            TextoBusqueda = e.Value?.ToString() ?? string.Empty;
        }

        if (string.IsNullOrEmpty(TextoBusqueda))
        {
            RepresentantesFiltrados = new List<Dictionary<string, object>>(Representantes);
        }
        else
        {
            var textoBusquedaLower = TextoBusqueda.ToLower().Trim();

            RepresentantesFiltrados = Representantes.Where(r =>
            {
                var nombreIndicador = ObtenerNombreIndicador(ObtenerValor(r, "fkidindicador")).ToLower();
                var nombreRepresentante = ObtenerNombreRepresentante(ObtenerValor(r, "fkidrepresenvisual")).ToLower();

                return nombreIndicador.Contains(textoBusquedaLower) ||
                       nombreRepresentante.Contains(textoBusquedaLower);
            }).ToList();
        }

        StateHasChanged(); // Notify Blazor that the state has changed and UI should re-render
    }

    private void LimpiarBusqueda()
    {
        TextoBusqueda = string.Empty;
        RepresentantesFiltrados = new List<Dictionary<string, object>>(Representantes);
        StateHasChanged();
    }


    private async Task MostrarFormularioCrear()
    {
        // Modified: Verifiers and Validators cannot create
        if (EsVerificador || EsValidador)
            return;
        ModoEdicion = false;
        RelacionActual = new();
        await modalFormulario!.ShowModalAsync(); // Use null-forgiving operator
    }

    private async Task MostrarFormularioEditar(Dictionary<string, object> relacion)
    {
        // Modified: Only verifiers cannot edit (validators can edit)
        if (EsVerificador)
            return;
        ModoEdicion = true;
        RelacionActual = new()
            {
                IdIndicador = Convert.ToInt32(ObtenerValor(relacion, "fkidindicador")),
                IdRepresentanteVisual = Convert.ToInt32(ObtenerValor(relacion, "fkidrepresenvisual"))
            };
        RelacionOriginal = new() // Store original for the update procedure
            {
                IdIndicador = RelacionActual.IdIndicador,
                IdRepresentanteVisual = RelacionActual.IdRepresentanteVisual
            };
        await modalFormulario!.ShowModalAsync(); // Use null-forgiving operator
    }

    private async Task ConfirmarEliminar(Dictionary<string, object> relacion)
    {
        // Modified: Verifiers and Validators cannot delete
        if (EsVerificador || EsValidador)
            return;
        RelacionAEliminar = new()
            {
                IdIndicador = Convert.ToInt32(ObtenerValor(relacion, "fkidindicador")),
                IdRepresentanteVisual = Convert.ToInt32(ObtenerValor(relacion, "fkidrepresenvisual"))
            };
        await modalConfirmacion!.ShowModalAsync(); // Use null-forgiving operator
    }

    private async Task GuardarRelacion()
    {
        // Modified: Verifiers cannot save (create or edit)
        if (EsVerificador)
            return;

        // Added: Validators cannot create, only edit
        if (EsValidador && !ModoEdicion)
            return;

        try
        {
            if (!ValidarRelacion()) return;

            bool resultado = false; // Initialize result

            if (ModoEdicion)
            {
                resultado = await ActualizarRelacion();
            }
            else
            {
                resultado = await CrearRelacion();
            }

            if (resultado)
            {
                await ActualizarUI();
                MostrarExito(ModoEdicion ? "Relación actualizada con éxito." : "Relación creada con éxito.");
            }
            else
            {
                MostrarError(ModoEdicion ? "No se pudo actualizar la relación." : "No se pudo crear la relación.");
            }
        }
        catch (Exception ex)
        {
            MostrarError($"Error al guardar: {ex.Message}");
        }
    }

    private bool ValidarRelacion()
    {
        if (RelacionActual.IdIndicador <= 0)
        {
            MostrarError("Seleccione un indicador.");
            return false;
        }

        if (RelacionActual.IdRepresentanteVisual <= 0)
        {
            MostrarError("Seleccione un representante visual.");
            return false;
        }

        // Check for existing relationship if in creation mode
        if (!ModoEdicion)
        {
            if (Representantes.Any(r =>
                Convert.ToInt32(ObtenerValor(r, "fkidindicador")) == RelacionActual.IdIndicador &&
                Convert.ToInt32(ObtenerValor(r, "fkidrepresenvisual")) == RelacionActual.IdRepresentanteVisual))
            {
                MostrarError("Esta relación entre indicador y representante visual ya existe.");
                return false;
            }
        }
        else // In edit mode, check if the new combination already exists, but exclude the original
        {
            if (Representantes.Any(r =>
                Convert.ToInt32(ObtenerValor(r, "fkidindicador")) == RelacionActual.IdIndicador &&
                Convert.ToInt32(ObtenerValor(r, "fkidrepresenvisual")) == RelacionActual.IdRepresentanteVisual &&
                (Convert.ToInt32(ObtenerValor(r, "fkidindicador")) != RelacionOriginal.IdIndicador ||
                 Convert.ToInt32(ObtenerValor(r, "fkidrepresenvisual")) != RelacionOriginal.IdRepresentanteVisual)))
            {
                MostrarError("La relación modificada ya existe para otro registro.");
                return false;
            }
        }


        return true;
    }

    private async Task<bool> CrearRelacion()
    {
        var data = new Dictionary<string, object>
            {
                ["fkidindicador"] = RelacionActual.IdIndicador,
                ["fkidrepresenvisual"] = RelacionActual.IdRepresentanteVisual,
                ["accion"] = "create", // Action for the stored procedure
                ["indicadorInicial"] = 0, // Not used for create, but good to include if SP expects it
                ["repreInicial"] = 0 // Not used for create, but good to include if SP expects it
            };

        try
        {
            var respuesta = await ServicioEntidad.EjecutarProcedimientoAsync(
                NOMBRE_TABLA,
                PROCEDIMIENTO_ACCIONES,
                data
            );
            return respuesta != null && respuesta.Count > 0 && Convert.ToBoolean(respuesta.FirstOrDefault()?.GetValueOrDefault("success") ?? false);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al ejecutar procedimiento de creación: {ex.Message}");
            return false;
        }
    }

    private async Task<bool> ActualizarRelacion()
    {
        var parametros = new Dictionary<string, object>
            {
                ["accion"] = "edit",
                ["fkidindicador"] = RelacionActual.IdIndicador,
                ["fkidrepresenvisual"] = RelacionActual.IdRepresentanteVisual,
                ["indicadorInicial"] = RelacionOriginal.IdIndicador,
                ["repreInicial"] = RelacionOriginal.IdRepresentanteVisual
            };

        try
        {
            var respuesta = await ServicioEntidad.EjecutarProcedimientoAsync(
                NOMBRE_TABLA,
                PROCEDIMIENTO_ACCIONES,
                parametros
            );
            return respuesta != null && respuesta.Count > 0 && Convert.ToBoolean(respuesta.FirstOrDefault()?.GetValueOrDefault("success") ?? false);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al ejecutar procedimiento de actualización: {ex.Message}");
            return false;
        }
    }

    private async Task EliminarRelacion()
    {
        // Modified: Verifiers and Validators cannot delete
        if (EsVerificador || EsValidador)
            return;
        try
        {
            var parametros = new Dictionary<string, object>
                {
                    ["accion"] = "delete",
                    ["fkidindicador"] = RelacionAEliminar.IdIndicador,
                    ["fkidrepresenvisual"] = RelacionAEliminar.IdRepresentanteVisual,
                    ["indicadorInicial"] = 0, // Not used for delete, but good to include if SP expects it
                    ["repreInicial"] = 0 // Not used for delete, but good to include if SP expects it
                };

            var respuesta = await ServicioEntidad.EjecutarProcedimientoAsync(
                NOMBRE_TABLA,
                PROCEDIMIENTO_ACCIONES,
                parametros
            );

            if (respuesta != null && respuesta.Count > 0 && Convert.ToBoolean(respuesta.FirstOrDefault()?.GetValueOrDefault("success") ?? false))
            {
                await ActualizarUI();
                MostrarExito("Relación eliminada con éxito.");
            }
            else
            {
                MostrarError("No se pudo eliminar la relación.");
            }
        }
        catch (Exception ex)
        {
            MostrarError($"Error al eliminar: {ex.Message}");
        }
    }

    private async Task ActualizarUI()
    {
        await CargarRelaciones();
        await modalFormulario!.HideModalAsync();
        await modalConfirmacion!.HideModalAsync();
        LimpiarMensajes();
    }

    private void MostrarError(string mensaje)
    {
        MensajeError = mensaje;
        MensajeExito = null;
        StateHasChanged();
    }

    private void MostrarExito(string mensaje)
    {
        MensajeExito = mensaje;
        MensajeError = null;
        StateHasChanged();
    }

    private void LimpiarMensajes()
    {
        MensajeError = null;
        MensajeExito = null;
        StateHasChanged();
    }

    private class RelacionModel
    {
        public int IdIndicador { get; set; }
        public int IdRepresentanteVisual { get; set; }
    }

    private class ItemSelectModel
    {
        public int Id { get; set; }
        public string Nombre { get; set; } = string.Empty;
    }
}