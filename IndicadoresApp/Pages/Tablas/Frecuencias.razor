@page "/frecuencia"
@using System.Collections.Generic
@using System.Text.Json
@using IndicadoresApp.Clases.IndicadoresApp.Clases
@inject IJSRuntime JSRuntime
@inject ServicioEntidad servicioEntidad
@inject NavigationManager navegacionManager
@inherits ValidacionAcceso

<PageTitle>Lista de frecuencias</PageTitle>

<h1>Frecuencias</h1>
@if (!EsVerificador)
{    
    <div class="mb-3">
        <button class="btn btn-primary" @onclick="MostrarFormularioCrear">Crear Nuevo</button>    
    </div>
}

<div class="mb-3">
    <div class="row">
        <div class="col-md-6">
            <div class="input-group">
                <input type="text"
                       class="form-control"
                       placeholder="Buscar por código o nombre..."
                       @bind="TextoBusqueda"
                       @oninput="FiltrarFrecuencias" />
                <button class="btn btn-outline-secondary" type="button" @onclick="LimpiarBusqueda">
                    <i class="fas fa-times"></i> Limpiar
                </button>
            </div>
        </div>
        <div class="col-md-6">
            <small class="text-muted">
                Mostrando @FrecuenciasFiltradas.Count de @frecuencias.Count frecuencias
            </small>
        </div>
    </div>
</div>

@if (cargando)
{
    <p><em>Cargando...</em></p>
}
else if (frecuencias == null || frecuencias.Count == 0)
{
    <p>No hay Tipos de frecuencias.</p>
}
else if (FrecuenciasFiltradas.Count == 0 && !string.IsNullOrEmpty(TextoBusqueda))
{
    <div class="alert alert-info">
        <i class="fas fa-search"></i> No se encontraron frecuencias que coincidan con "<strong>@TextoBusqueda</strong>"
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Nombre</th>
                    @if (!EsVerificador)
                    {
                        <th>Acciones</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var frecuencia in FrecuenciasFiltradas)
                {
                    <tr>
                        <td>@ObtenerValor(frecuencia, "id")</td>
                        <td>@ObtenerValor(frecuencia, "nombre")</td>
                        @if (!EsVerificador)
                        {
                            <td>
                                <button class="btn btn-warning btn-sm" @onclick="() => MostrarFormularioEditar(frecuencia)">Editar</button>
                                <button class="btn btn-danger btn-sm" @onclick="() => ConfirmarEliminar(frecuencia)">Eliminar</button>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (mostrarFormulario)
{
    <div class="modal" style="display:block; background-color: rgba(0,0,0,0.4);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(modoEdicion ? "Editar" : "Crear") Tipo de frecuencia</h5>
                    <button type="button" class="btn-close" @onclick="CerrarFormulario"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="nombre" class="form-label">Nombre</label>
                        <input type="text" class="form-control" id="nombre" @bind="frecuenciaActual.nombre" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CerrarFormulario">Cancelar</button>
                    <button type="button" class="btn btn-primary" @onclick="Guardarfrecuencia">Guardar</button>
                </div>
            </div>
        </div>
    </div>
}

@if (mostrarConfirmacion)
{
    <div class="modal" style="display:block; background-color: rgba(0,0,0,0.4);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmar eliminación</h5>
                    <button type="button" class="btn-close" @onclick="CancelarEliminar"></button>
                </div>
                <div class="modal-body">
                    <p>¿Está seguro que desea eliminar el frecuencia: @frecuenciaEliminar?.nombre?</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CancelarEliminar">Cancelar</button>
                    <button type="button" class="btn btn-danger" @onclick="Eliminarfrecuencia">Eliminar</button>
                </div>
            </div>
        </div>
    </div>
}

@if (errorMensaje != null)
{
    <div class="alert alert-danger">
        Error: @errorMensaje
    </div>
}

@if (exitoMensaje != null)
{
    <div class="alert alert-success">
        @exitoMensaje
    </div>
}

@code {
    private List<Dictionary<string, object>> frecuencias = new List<Dictionary<string, object>>();
    private List<Dictionary<string, object>> FrecuenciasFiltradas = new List<Dictionary<string, object>>();
    private bool cargando = true;
    private string? errorMensaje = null;
    private string? exitoMensaje = null;
    private const string TABLA = "frecuencia";
    private bool EsVerificador { get; set; } = false;

    // Variables para la búsqueda
    private string TextoBusqueda { get; set; } = string.Empty;

    // Variables para el formulario
    private bool mostrarFormulario = false;
    private bool modoEdicion = false;
    private FrecuenciaModel frecuenciaActual = new FrecuenciaModel();

    // Variables para confirmación de eliminación
    private bool mostrarConfirmacion = false;
    private FrecuenciaModel frecuenciaEliminar = new FrecuenciaModel();

    protected override async Task OnInitializedAsync()
    {
        var rol = await JSRuntime.InvokeAsync<string>("sessionStorage.getItem", "rolUsuario");
        EsVerificador = RutasPermisosService.EsRolVerificador(rol);
        await CargarFrecuencias(); // Renamed for clarity
    }

    private async Task CargarFrecuencias() // Renamed method
    {
        cargando = true;
        errorMensaje = null;

        try
        {
            var resultado = await servicioEntidad.ObtenerTodosAsync(TABLA);

            frecuencias = resultado ?? new List<Dictionary<string, object>>();
            FrecuenciasFiltradas = new List<Dictionary<string, object>>(frecuencias);

            // Aplicar filtro si hay texto de búsqueda
            if (!string.IsNullOrEmpty(TextoBusqueda))
            {
                FiltrarFrecuencias();
            }
        }
        catch (Exception ex)
        {
            errorMensaje = $"Error al cargar las frecuencias: {ex.Message}";
            frecuencias = new List<Dictionary<string, object>>();
            FrecuenciasFiltradas = new List<Dictionary<string, object>>();
        }
        finally
        {
            cargando = false;
        }
    }

    private string ObtenerValor(Dictionary<string, object> diccionario, string clave)
    {
        if (diccionario == null)
            return string.Empty;

        if (diccionario.TryGetValue(clave, out var valor))
        {
            return valor?.ToString() ?? string.Empty;
        }

        return string.Empty;
    }

    private void FiltrarFrecuencias(ChangeEventArgs? e = null)
    {
        if (e != null)
        {
            TextoBusqueda = e.Value?.ToString() ?? string.Empty;
        }

        if (string.IsNullOrEmpty(TextoBusqueda))
        {
            FrecuenciasFiltradas = new List<Dictionary<string, object>>(frecuencias);
        }
        else
        {
            var textoBusquedaLower = TextoBusqueda.ToLower().Trim();

            FrecuenciasFiltradas = frecuencias.Where(frecuencia =>
            {
                var codigo = ObtenerValor(frecuencia, "id").ToLower();
                var nombre = ObtenerValor(frecuencia, "nombre").ToLower();

                return codigo.Contains(textoBusquedaLower) ||
                       nombre.Contains(textoBusquedaLower);
            }).ToList();
        }

        StateHasChanged();
    }

    private void LimpiarBusqueda()
    {
        TextoBusqueda = string.Empty;
        FrecuenciasFiltradas = new List<Dictionary<string, object>>(frecuencias);
        StateHasChanged();
    }

    private void MostrarFormularioCrear()
    {
        if (EsVerificador)
            return;
        frecuenciaActual = new FrecuenciaModel();
        modoEdicion = false;
        mostrarFormulario = true;
    }

    private void MostrarFormularioEditar(Dictionary<string, object> frecuencia)
    {
        if (EsVerificador)
            return;

        frecuenciaActual = new FrecuenciaModel
        {
            id = ObtenerValor(frecuencia, "id"),
            nombre = ObtenerValor(frecuencia, "nombre")
        };
        modoEdicion = true;
        mostrarFormulario = true;
    }

    private void CerrarFormulario()
    {
        mostrarFormulario = false;
    }

    private async Task Guardarfrecuencia()
    {
        if (EsVerificador)
            return;

        errorMensaje = null;
        exitoMensaje = null;

        try
        {
            var frecuenciaDict = new Dictionary<string, object>
            {
                ["nombre"] = frecuenciaActual.nombre
            };

            bool resultado;

            if (modoEdicion)
            {
                resultado = await servicioEntidad.ActualizarAsync(
                    TABLA,
                    "id",
                    frecuenciaActual.id,
                    frecuenciaDict
                );

                if (resultado)
                {
                    exitoMensaje = "Frecuencia actualizada correctamente.";
                }
            }
            else
            {
                resultado = await servicioEntidad.CrearAsync(
                    TABLA,
                    frecuenciaDict
                );

                if (resultado)
                {
                    exitoMensaje = "Frecuencia creada correctamente.";
                }
            }

            if (resultado)
            {
                await CargarFrecuencias(); // Renamed method
                mostrarFormulario = false;
            }
            else
            {
                errorMensaje = "No se pudo guardar la frecuencia.";
            }
        }
        catch (Exception ex)
        {
            errorMensaje = $"Error al guardar la frecuencia: {ex.Message}";
        }
    }

    // Funciones para eliminar
    private void ConfirmarEliminar(Dictionary<string, object> frecuencia)
    {
        if (EsVerificador)
            return;

        frecuenciaEliminar = new FrecuenciaModel
        {
            id = ObtenerValor(frecuencia, "id"),
            nombre = ObtenerValor(frecuencia, "nombre")
        };
        mostrarConfirmacion = true;
    }

    private void CancelarEliminar()
    {
        mostrarConfirmacion = false;
    }

    private async Task Eliminarfrecuencia()
    {
        errorMensaje = null;
        exitoMensaje = null;

        try
        {
            var resultado = await servicioEntidad.EliminarAsync(
                TABLA,
                "id",
                frecuenciaEliminar.id
            );

            if (resultado)
            {
                exitoMensaje = "Frecuencia eliminada correctamente.";
                await CargarFrecuencias(); // Renamed method
            }
            else
            {
                errorMensaje = "No se pudo eliminar la frecuencia.";
            }

            mostrarConfirmacion = false;
        }
        catch (Exception ex)
        {
            errorMensaje = $"Error al eliminar la frecuencia: {ex.Message}";
        }
    }
}