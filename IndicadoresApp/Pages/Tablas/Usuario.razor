@page "/Usuario"
@using System.Collections.Generic
@using System.Text.Json
@using System.Net.Http
@using System.Net.Http.Json
@using System.Linq
@using System.Text
@inherits ValidacionAcceso

@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@inject ServicioEntidad servicioEntidad
@inject NavigationManager navegacionManager

<PageTitle>Usuarios</PageTitle>

<div class="container">
    <div class="row mb-4">
        <div class="col-12">
            <h1>Gestión de Usuarios</h1>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-12">
            @if (roles.Contains("Verificador") || roles.Contains("Validador"))
            {
                <button class="btn btn-primary" disabled>Crear Nuevo</button>
            }
            else
            {
                <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#usuarioModal"
                        @onclick='() => AbrirModal("ejemplo@ejemplo.com", "", "Create")'>
                    <i class="bi bi-person-plus"></i> Crear Nuevo Usuario
                </button>
            }
        </div>
    </div>

    @if (cargando)
    {
        <div class="row">
            <div class="col-12 text-center">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Cargando...</span>
                </div>
                <p><em>Cargando datos de usuarios...</em></p>
            </div>
        </div>
    }
    else if (tipoActores == null || tipoActores.Count == 0)
    {
        <div class="alert alert-info" role="alert">
            No hay usuarios disponibles en el sistema.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Email</th>
                        <th>Contraseña</th>
                        @if (!roles.Contains("Verificador"))
                        {
                            <th>Editar</th>
                            @if (!roles.Contains("Validador"))
                            {
                                <th>Eliminar</th>
                            }
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var usuario in tipoActores)
                    {
                        string email = ObtenerValor(usuario, "email");
                        string password = ObtenerValor(usuario, "contrasena");

                        <tr>
                            <td>@email</td>
                            <td>@password</td>
                            @if (!roles.Contains("Verificador"))
                            {
                                <td>
                                    <button class="btn btn-sm btn-primary" data-bs-toggle="modal"
                                            data-bs-target="#usuarioModal"
                                            @onclick='() => AbrirModal(email, password, "Edit")'>
                                        <i class="bi bi-pencil"></i> Editar
                                    </button>
                                </td>

                                @if (!roles.Contains("Validador"))
                                {
                                    <td>
                                        <button id='@email' class="btn btn-sm btn-danger"
                                                @onclick="() => ConfirmarEliminacion(email)">
                                            <i class="bi bi-trash"></i> Eliminar
                                        </button>
                                    </td>
                                }
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Toast para mensajes -->
@if (mensaje != null)
{
    <div class="toast-container position-fixed bottom-0 end-0 p-3">
        <div id="liveToast" class="toast align-items-center text-white bg-@tipoAlerta border-0 show"
             role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body">
                    @mensaje
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto"
                        data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    </div>
}

<!-- Modal de Usuario -->
<div class="modal fade" id="usuarioModal" tabindex="-1" aria-labelledby="usuarioModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="usuarioModalLabel">
                    @(peticionSeleccionada == "Create" ? "Crear Nuevo Usuario" : "Editar Usuario")
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label for="email" class="form-label">Email:</label>
                    <input type="email" id="email" class="form-control" @bind="emailSeleccionado"
                           placeholder="Ingrese el correo electrónico">
                </div>
                <div class="mb-3">
                    <label for="pass" class="form-label">Contraseña:</label>
                    <input type="password" id="pass" class="form-control" @bind="contraSeleccionada"
                           placeholder="Ingrese la contraseña">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal" @onclick="GuardarCambios">
                    @(peticionSeleccionada == "Create" ? "Crear" : "Guardar cambios")
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal de Confirmación para Eliminar -->
<div class="modal fade" id="confirmDeleteModal" tabindex="-1" aria-labelledby="confirmDeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="confirmDeleteModalLabel">Confirmar Eliminación</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                ¿Está seguro que desea eliminar el usuario con email <strong>@emailParaEliminar</strong>?
                Esta acción no se puede deshacer.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-danger" data-bs-dismiss="modal" @onclick="() => EliminarRegistro(emailParaEliminar)">
                    Eliminar
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    private List<Dictionary<string, object>> tipoActores = new List<Dictionary<string, object>>();
    private HttpClient? _httpClient = new HttpClient();
    private List<string> roles = new List<string>();
    private bool cargando = true;
    private string? mensaje = null;
    private string? tipoAlerta = "info";
    private const string TABLA = "usuario";

    // Variables para el modal
    private string contraSeleccionada = "";
    private string emailSeleccionado = "";
    private string emailInicial = "";
    private string peticionSeleccionada = "";
    private string emailParaEliminar = "";

    protected override async Task OnInitializedAsync()
    {
        await CargarTipoActor();
        await CargarRoles();
    }

    private async Task CargarRoles()
    {
        var scriptRoles = @"
            Object.keys(sessionStorage)
                .filter(key => key.startsWith('rolUsuario'))
                .map(key => sessionStorage.getItem(key))
        ";

        roles = await JSRuntime.InvokeAsync<List<string>>("eval", scriptRoles);
    }

    private async Task CargarTipoActor()
    {
        cargando = true;
        mensaje = null;

        try
        {
            var resultado = await servicioEntidad.ObtenerTodosAsync(TABLA);

            if (resultado != null)
            {
                tipoActores = resultado;
            }
            else
            {
                tipoActores = new List<Dictionary<string, object>>();
            }
        }
        catch (Exception ex)
        {
            MostrarMensaje($"Error al cargar usuarios: {ex.Message}", "danger");
            tipoActores = new List<Dictionary<string, object>>();
        }
        finally
        {
            cargando = false;
        }
    }

    private string ObtenerValor(Dictionary<string, object> diccionario, string clave)
    {
        if (diccionario == null)
            return string.Empty;

        if (diccionario.TryGetValue(clave, out var valor))
        {
            return valor?.ToString() ?? string.Empty;
        }

        return string.Empty;
    }

    public void AbrirModal(string idEmail, string pass, string peticion)
    {
        emailSeleccionado = idEmail;
        emailInicial = idEmail;
        contraSeleccionada = pass;
        peticionSeleccionada = peticion;
    }

    private void ConfirmarEliminacion(string email)
    {
        emailParaEliminar = email;
        JSRuntime.InvokeVoidAsync("bootstrap.Modal.getOrCreateInstance", "#confirmDeleteModal").then(modal =>
            JSRuntime.InvokeVoidAsync("bootstrap.Modal.getInstance", "#confirmDeleteModal", "show")
        );
    }

    private async Task GuardarCambios()
    {
        if (string.IsNullOrWhiteSpace(emailSeleccionado) || string.IsNullOrWhiteSpace(contraSeleccionada))
        {
            MostrarMensaje("El email y la contraseña son obligatorios", "warning");
            return;
        }

        var body = new Dictionary<string, object>
        {
            { "email", emailSeleccionado },
            { "contrasena", contraSeleccionada }
        };

        try
        {
            bool resultado = false;
            string tipoMsg = string.Empty;

            if (peticionSeleccionada == "Create")
            {
                resultado = await servicioEntidad.CrearAsync(TABLA, body);
                tipoMsg = "creado";
            }
            else if (peticionSeleccionada == "Edit")
            {
                resultado = await servicioEntidad.ActualizarAsync(TABLA, "email", emailInicial, body);
                tipoMsg = "actualizado";
            }
            else
            {
                MostrarMensaje("Acción no permitida, seleccione una acción válida", "warning");
                return;
            }

            if (resultado)
            {
                MostrarMensaje($"Usuario {tipoMsg} exitosamente", "success");
                await CargarTipoActor();
            }
            else
            {
                MostrarMensaje($"Error al {tipoMsg} el usuario", "danger");
            }
        }
        catch (HttpRequestException ex)
        {
            MostrarMensaje($"Error en la petición: {ex.Message}", "danger");
            Console.WriteLine($"Error en la petición: {ex.Message}");
        }
    }

    private async Task EliminarRegistro(string email)
    {
        try
        {
            var respuesta = await servicioEntidad.EliminarAsync(TABLA, "email", email);

            if (respuesta)
            {
                MostrarMensaje("Usuario eliminado exitosamente", "success");
                await CargarTipoActor();
            }
            else
            {
                MostrarMensaje("Error al eliminar el usuario", "danger");
            }
        }
        catch (HttpRequestException ex)
        {
            MostrarMensaje($"Error en la petición: {ex.Message}", "danger");
            Console.WriteLine($"Error en la petición: {ex.Message}");
        }
    }

    private void MostrarMensaje(string msg, string tipo)
    {
        mensaje = msg;
        tipoAlerta = tipo;
        ResetMensaje();
    }

    private async void ResetMensaje()
    {
        await Task.Delay(3000);
        mensaje = null;
        tipoAlerta = "info";
        StateHasChanged();
    }
}