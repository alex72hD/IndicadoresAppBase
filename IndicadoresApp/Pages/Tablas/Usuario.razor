@page "/Usuario"
@using System.Collections.Generic
@using System.Text.Json
@using System.Net.Http
@using System.Net.Http.Json
@using System.Linq
@using System.Text
@inherits ValidacionAcceso

@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@inject ServicioEntidad servicioEntidad

<PageTitle>Usuarios</PageTitle>

<h1>Usuarios</h1>

@if (roles.Contains("Verificador") || roles.Contains("Validador"))
{
    <div class="mb-3">
        <button class="btn btn-primary" disabled>Crear Nuevo</button>
    </div>
}
else
{
    <div class="mb-3">
        <button class="btn btn-primary" @onclick="MostrarFormularioCrear">Crear Nuevo</button>
    </div>
}

@if (cargando)
{
    <p><em>Cargando...</em></p>
}
else if (tipoActores == null || tipoActores.Count == 0)
{
    <p>No hay información disponible.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Email</th>
                    <th>Contraseña</th>
                    @if (!roles.Contains("Verificador"))
                    {
                        <th>Acciones</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var tpActor in tipoActores)
                {
                    string tempId = @ObtenerValor(tpActor, "email");
                    string tempPass = @ObtenerValor(tpActor, "contrasena");

                    <tr>
                        <td>@tempId</td>
                        <td>@tempPass</td>
                        @if (!roles.Contains("Verificador"))
                        {
                            <td>
                                <button class="btn btn-warning btn-sm" @onclick="() => MostrarFormularioEditar(tempId, tempPass)">Editar</button>
                                @if (!roles.Contains("Validador"))
                                {
                                    <button class="btn btn-danger btn-sm" @onclick="() => ConfirmarEliminar(tempId)">Eliminar</button>
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<!-- Modal para crear/editar usuario -->
@if (mostrarModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(modoEdicion ? "Editar Usuario" : "Crear Usuario")</h5>
                    <button type="button" class="btn-close" @onclick="CerrarModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="email" class="form-label">Email:</label>
                        <input type="email" id="email" class="form-control" @bind="emailSeleccionado" @bind:event="oninput" required>
                    </div>
                    <div class="mb-3">
                        <label for="pass" class="form-label">Contraseña:</label>
                        <input type="password" id="pass" class="form-control" @bind="contraSeleccionada" @bind:event="oninput" required>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CerrarModal">Cancelar</button>
                    <button type="button" class="btn btn-primary" @onclick="GuardarCambios" disabled="@guardando">
                        @if (guardando)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Guardar
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal de confirmación para eliminar -->
@if (mostrarModalEliminar)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmar eliminación</h5>
                    <button type="button" class="btn-close" @onclick="CerrarModalEliminar"></button>
                </div>
                <div class="modal-body">
                    <p>¿Está seguro que desea eliminar el usuario: <strong>@emailAEliminar</strong>?</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CerrarModalEliminar">Cancelar</button>
                    <button type="button" class="btn btn-danger" @onclick="EliminarRegistro" disabled="@eliminando">
                        @if (eliminando)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Eliminar
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Mensajes de alerta -->
@if (!string.IsNullOrEmpty(mensaje))
{
    <div class="alert alert-@tipoAlerta alert-dismissible fade show mt-3">
        @mensaje
        <button type="button" class="btn-close" @onclick="LimpiarMensaje"></button>
    </div>
}

@code {
    // Variables de datos
    private List<Dictionary<string, object>> tipoActores = new List<Dictionary<string, object>>();
    private List<string> roles = new List<string>();
    private bool cargando = true;
    private const string TABLA = "usuario";

    // Variables de mensajes
    private string? mensaje = null;
    private string? tipoAlerta = "info";

    // Variables del modal principal
    private bool mostrarModal = false;
    private bool modoEdicion = false;
    private bool guardando = false;
    private string emailSeleccionado = "";
    private string contraSeleccionada = "";
    private string emailInicial = "";

    // Variables del modal de eliminación
    private bool mostrarModalEliminar = false;
    private bool eliminando = false;
    private string emailAEliminar = "";

    protected override async Task OnInitializedAsync()
    {
        await CargarRoles();
        await CargarTipoActor();
    }

    private async Task CargarRoles()
    {
        try
        {
            var scriptRoles = @"
                Object.keys(sessionStorage)
                    .filter(key => key.startsWith('rolUsuario'))
                    .map(key => sessionStorage.getItem(key))
            ";

            roles = await JSRuntime.InvokeAsync<List<string>>("eval", scriptRoles);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando roles: {ex.Message}");
            roles = new List<string>();
        }
    }

    private async Task CargarTipoActor()
    {
        cargando = true;
        LimpiarMensaje();

        try
        {
            var resultado = await servicioEntidad.ObtenerTodosAsync(TABLA);
            tipoActores = resultado ?? new List<Dictionary<string, object>>();
        }
        catch (Exception ex)
        {
            MostrarMensaje($"Error al cargar usuarios: {ex.Message}", "danger");
            tipoActores = new List<Dictionary<string, object>>();
        }
        finally
        {
            cargando = false;
        }
    }

    private string ObtenerValor(Dictionary<string, object> diccionario, string clave)
    {
        if (diccionario?.TryGetValue(clave, out var valor) == true)
        {
            return valor?.ToString() ?? string.Empty;
        }
        return string.Empty;
    }

    // Métodos del modal principal
    private void MostrarFormularioCrear()
    {
        emailSeleccionado = "";
        contraSeleccionada = "";
        emailInicial = "";
        modoEdicion = false;
        mostrarModal = true;
        LimpiarMensaje();
    }

    private void MostrarFormularioEditar(string email, string password)
    {
        emailSeleccionado = email;
        contraSeleccionada = password;
        emailInicial = email;
        modoEdicion = true;
        mostrarModal = true;
        LimpiarMensaje();
    }

    private void CerrarModal()
    {
        mostrarModal = false;
        guardando = false;
    }

    private async Task GuardarCambios()
    {
        // Validaciones
        if (string.IsNullOrWhiteSpace(emailSeleccionado) || string.IsNullOrWhiteSpace(contraSeleccionada))
        {
            MostrarMensaje("Todos los campos son obligatorios", "warning");
            return;
        }

        guardando = true;

        try
        {
            var body = new Dictionary<string, object>
            {
                { "email", emailSeleccionado.Trim() },
                { "contrasena", contraSeleccionada.Trim() }
            };

            bool resultado = false;
            string operacion = "";

            if (modoEdicion)
            {
                resultado = await servicioEntidad.ActualizarAsync(TABLA, "email", emailInicial, body);
                operacion = "actualizado";
            }
            else
            {
                resultado = await servicioEntidad.CrearAsync(TABLA, body);
                operacion = "creado";
            }

            if (resultado)
            {
                MostrarMensaje($"Usuario {operacion} exitosamente!", "success");
                CerrarModal();
                await CargarTipoActor();
            }
            else
            {
                MostrarMensaje($"Error: No se pudo {(modoEdicion ? "actualizar" : "crear")} el usuario", "danger");
            }
        }
        catch (Exception ex)
        {
            MostrarMensaje($"Error: {ex.Message}", "danger");
            Console.WriteLine($"Error en GuardarCambios: {ex.Message}");
        }
        finally
        {
            guardando = false;
        }
    }

    // Métodos del modal de eliminación
    private void ConfirmarEliminar(string email)
    {
        emailAEliminar = email;
        mostrarModalEliminar = true;
        LimpiarMensaje();
    }

    private void CerrarModalEliminar()
    {
        mostrarModalEliminar = false;
        eliminando = false;
        emailAEliminar = "";
    }

    private async Task EliminarRegistro()
    {
        eliminando = true;

        try
        {
            var resultado = await servicioEntidad.EliminarAsync(TABLA, "email", emailAEliminar);

            if (resultado)
            {
                MostrarMensaje("Usuario eliminado exitosamente!", "success");
                CerrarModalEliminar();
                await CargarTipoActor();
            }
            else
            {
                MostrarMensaje("Error: No se pudo eliminar el usuario", "danger");
            }
        }
        catch (Exception ex)
        {
            MostrarMensaje($"Error al eliminar: {ex.Message}", "danger");
            Console.WriteLine($"Error en EliminarRegistro: {ex.Message}");
        }
        finally
        {
            eliminando = false;
        }
    }

    // Métodos de mensajes
    private void MostrarMensaje(string msg, string tipo)
    {
        mensaje = msg;
        tipoAlerta = tipo;
        StateHasChanged();
    }

    private void LimpiarMensaje()
    {
        mensaje = null;
        tipoAlerta = "info";
    }
}