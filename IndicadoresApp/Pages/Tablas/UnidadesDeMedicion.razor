@page "/unidadmedicion"
@using System.Collections.Generic
@using System.Text.Json
@using IndicadoresApp.Clases.IndicadoresApp.Clases
@using IndicadoresApp.ModalGenerico
@using IndicadoresApp.Clases
@inject ServicioEntidad ServicioEntidad
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inherits ValidacionAcceso

<PageTitle>Unidades de Medición</PageTitle>

<h1>Unidades de Medición</h1>

@* Solo los verificadores y validadores no pueden crear/editar/eliminar *@
@if (!EsVerificador && !EsValidador)
{
    <div class="mb-3">
        <button class="btn btn-primary" @onclick="MostrarFormularioCrear">Crear Nueva</button>
    </div>
}

<!-- Campo de búsqueda -->
<div class="mb-3">
    <div class="row">
        <div class="col-md-6">
            <div class="input-group">
                <input type="text"
                       class="form-control"
                       placeholder="Buscar por código o nombre..."
                       @bind="TextoBusqueda"
                       @oninput="FiltrarUnidades" />
                <button class="btn btn-outline-secondary" type="button" @onclick="LimpiarBusqueda">
                    <i class="fas fa-times"></i> Limpiar
                </button>
            </div>
        </div>
        <div class="col-md-6">
            <small class="text-muted">
                Mostrando @UnidadesFiltradas.Count de @UnidadesMedicion.Count unidades
            </small>
        </div>
    </div>
</div>

@if (EstamosCargando)
{
    <p><em>Cargando...</em></p>
}
else if (UnidadesMedicion == null || UnidadesMedicion.Count == 0)
{
    <p>No hay unidades de medición registradas.</p>
}
else if (UnidadesFiltradas.Count == 0 && !string.IsNullOrEmpty(TextoBusqueda))
{
    <div class="alert alert-info">
        <i class="fas fa-search"></i> No se encontraron unidades de medición que coincidan con "<strong>@TextoBusqueda</strong>"
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Nombre</th>
                    @* Solo los verificadores y validadores no ven las acciones *@
                    @if (!EsVerificador && !EsValidador)
                    {
                        <th>Acciones</th>
                    }
                    @* Los validadores solo pueden editar *@
                    @if (EsValidador && !EsVerificador)
                    {
                        <th>Acciones</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var unidad in UnidadesFiltradas)
                {
                    <tr>
                        <td>@ObtenerValor(unidad, "id")</td>
                        <td>@ObtenerValor(unidad, "descripcion")</td>
                        @* Administradores pueden hacer todo *@
                        @if (!EsVerificador && !EsValidador)
                        {
                            <td>
                                <button class="btn btn-warning btn-sm" @onclick="() => MostrarFormularioEditar(unidad)">Editar</button>
                                <button class="btn btn-danger btn-sm" @onclick="() => ConfirmarEliminar(unidad)">Eliminar</button>
                            </td>
                        }
                        @* Los validadores solo pueden editar *@
                        @if (EsValidador && !EsVerificador)
                        {
                            <td>
                                <button class="btn btn-warning btn-sm" @onclick="() => MostrarFormularioEditar(unidad)">Editar</button>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<!-- Modal para crear/editar unidad -->
<ModalGenerico @ref="modalFormulario"
               Id="formModal"
               Title="@TituloModal"
               OnSave="GuardarUnidad">
    <BodyContent>
        <div class="mb-3">
            <label for="nombre" class="form-label">Nombre</label>
            <input type="text" class="form-control" id="nombre" @bind="UnidadActual.Nombre" />
        </div>
    </BodyContent>
</ModalGenerico>

<!-- Modal para confirmar eliminación -->
<ModalGenerico @ref="modalConfirmacion"
               Id="confirmModal"
               Title="Confirmar eliminación"
               OnSave="EliminarUnidad">
    <BodyContent>
        <p>¿Está seguro que desea eliminar la unidad de medición: @UnidadAEliminar.Nombre?</p>
    </BodyContent>
</ModalGenerico>

@if (!string.IsNullOrEmpty(MensajeError))
{
    <div class="alert alert-danger">
        Error: @MensajeError
    </div>
}

@if (!string.IsNullOrEmpty(MensajeExito))
{
    <div class="alert alert-success">
        @MensajeExito
    </div>
}

@code {
    private const string NOMBRE_TABLA = "unidadmedicion";

    private List<Dictionary<string, object>> UnidadesMedicion { get; set; } = new();
    private List<Dictionary<string, object>> UnidadesFiltradas { get; set; } = new();
    private bool EstamosCargando { get; set; } = true;
    private string? MensajeError { get; set; }
    private string? MensajeExito { get; set; }

    // Variables para control de roles
    private bool EsVerificador { get; set; } = false;
    private bool EsValidador { get; set; } = false;

    // Variables para la búsqueda
    private string TextoBusqueda { get; set; } = string.Empty;

    // Variables para el formulario
    private bool ModoEdicion { get; set; } = false;
    private UnidadMedicionModel UnidadActual { get; set; } = new();
    private ModalGenerico? modalFormulario;
    //operador ternario para usar alguna de las dos opciones tanto en crear como en editar
    private string TituloModal => $"{(ModoEdicion ? "Editar" : "Crear")} Unidad de Medición";

    // Variables para confirmación de eliminación
    private UnidadMedicionModel UnidadAEliminar { get; set; } = new();
    private ModalGenerico? modalConfirmacion;

    protected override async Task OnInitializedAsync()
    {
        // Verificar roles del usuario
        var rol = await JSRuntime.InvokeAsync<string>("sessionStorage.getItem", "rolUsuario");
        EsVerificador = RutasPermisosService.EsRolVerificador(rol);
        EsValidador = RutasPermisosService.EsRolValidador(rol);

        await CargarUnidadesMedicion();
    }

    private async Task CargarUnidadesMedicion()
    {
        EstamosCargando = true;
        MensajeError = null;

        try
        {
            var resultado = await ServicioEntidad.ObtenerTodosAsync(NOMBRE_TABLA);

            UnidadesMedicion = resultado ?? new List<Dictionary<string, object>>();
            UnidadesFiltradas = new List<Dictionary<string, object>>(UnidadesMedicion);

            // Aplicar filtro si hay texto de búsqueda
            if (!string.IsNullOrEmpty(TextoBusqueda))
            {
                FiltrarUnidades();
            }
        }
        catch (Exception ex)
        {
            MensajeError = $"Error al cargar unidades de medición: {ex.Message}";
            UnidadesMedicion = new List<Dictionary<string, object>>();
            UnidadesFiltradas = new List<Dictionary<string, object>>();
        }
        finally
        {
            EstamosCargando = false;
        }
    }

    private string ObtenerValor(Dictionary<string, object> diccionario, string clave)
    {
        if (diccionario == null)
            return string.Empty;

        if (diccionario.TryGetValue(clave, out var valor))
        {
            return valor?.ToString() ?? string.Empty;
        }

        return string.Empty;
    }

    private void FiltrarUnidades(ChangeEventArgs? e = null)
    {
        if (e != null)
        {
            TextoBusqueda = e.Value?.ToString() ?? string.Empty;
        }

        if (string.IsNullOrEmpty(TextoBusqueda))
        {
            UnidadesFiltradas = new List<Dictionary<string, object>>(UnidadesMedicion);
        }
        else
        {
            var textoBusquedaLower = TextoBusqueda.ToLower().Trim();

            UnidadesFiltradas = UnidadesMedicion.Where(unidad =>
            {
                var codigo = ObtenerValor(unidad, "id").ToLower();
                var nombre = ObtenerValor(unidad, "descripcion").ToLower();

                return codigo.Contains(textoBusquedaLower) ||
                       nombre.Contains(textoBusquedaLower);
            }).ToList();
        }

        StateHasChanged();
    }

    private void LimpiarBusqueda()
    {
        TextoBusqueda = string.Empty;
        UnidadesFiltradas = new List<Dictionary<string, object>>(UnidadesMedicion);
        StateHasChanged();
    }

    private async Task MostrarFormularioCrear()
    {
        // Los verificadores y validadores no pueden crear
        if (EsVerificador || EsValidador)
            return;

        UnidadActual = new UnidadMedicionModel();
        ModoEdicion = false;
        await InvokeAsync(StateHasChanged);
        await modalFormulario.ShowModalAsync();
    }

    private async Task MostrarFormularioEditar(Dictionary<string, object> unidad)
    {
        // Solo los verificadores no pueden editar (los validadores sí pueden)
        if (EsVerificador)
            return;

        UnidadActual = new UnidadMedicionModel
            {
                Id = ObtenerValor(unidad, "id"),
                Nombre = ObtenerValor(unidad, "descripcion")
            };
        ModoEdicion = true;
        await InvokeAsync(StateHasChanged);
        await modalFormulario.ShowModalAsync();
    }

    private async Task ConfirmarEliminar(Dictionary<string, object> unidad)
    {
        // Los verificadores y validadores no pueden eliminar
        if (EsVerificador || EsValidador)
            return;

        UnidadAEliminar = new UnidadMedicionModel
            {
                Id = ObtenerValor(unidad, "id"),
                Nombre = ObtenerValor(unidad, "descripcion")
            };
        await InvokeAsync(StateHasChanged);
        await modalConfirmacion.ShowModalAsync();
    }

    private async Task GuardarUnidad()
    {
        // Solo los verificadores no pueden guardar (los validadores sí pueden editar)
        if (EsVerificador)
            return;

        // Los validadores no pueden crear, solo editar
        if (EsValidador && !ModoEdicion)
            return;

        MensajeError = null;
        MensajeExito = null;

        try
        {
            var unidadDict = new Dictionary<string, object>
                {
                    ["descripcion"] = UnidadActual.Nombre
                };

            bool resultado;

            if (ModoEdicion)
            {
                resultado = await ServicioEntidad.ActualizarAsync(
                    NOMBRE_TABLA,
                    "id",
                    UnidadActual.Id,
                    unidadDict
                );

                if (resultado)
                {
                    MensajeExito = "Unidad de medición actualizada correctamente.";
                }
            }
            else
            {
                resultado = await ServicioEntidad.CrearAsync(
                    NOMBRE_TABLA,
                    unidadDict
                );

                if (resultado)
                {
                    MensajeExito = "Unidad de medición creada correctamente.";
                }
            }

            if (resultado)
            {
                await CargarUnidadesMedicion();
            }
            else
            {
                MensajeError = "No se pudo guardar la unidad de medición.";
            }
        }
        catch (Exception ex)
        {
            MensajeError = $"Error al guardar la unidad de medición: {ex.Message}";
        }
    }

    private async Task EliminarUnidad()
    {
        // Los verificadores y validadores no pueden eliminar
        if (EsVerificador || EsValidador)
            return;

        MensajeError = null;
        MensajeExito = null;

        try
        {
            var resultado = await ServicioEntidad.EliminarAsync(
                NOMBRE_TABLA,
                "id",
                UnidadAEliminar.Id
            );

            if (resultado)
            {
                MensajeExito = "Unidad de medición eliminada correctamente.";
                await CargarUnidadesMedicion();
            }
            else
            {
                MensajeError = "No se pudo eliminar la unidad de medición.";
            }
        }
        catch (Exception ex)
        {
            MensajeError = $"Error al eliminar la unidad de medición: {ex.Message}";
        }
    }
}