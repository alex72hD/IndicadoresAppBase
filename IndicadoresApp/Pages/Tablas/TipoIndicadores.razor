@page "/tipoindicador"
@using System.Collections.Generic
@using System.Text.Json
@using IndicadoresApp.Clases.IndicadoresApp.Clases
@using IndicadoresApp.ModalGenerico
@using IndicadoresApp.Clases
@inject ServicioEntidad servicioEntidad
@inject NavigationManager navegacionManager
@inject IJSRuntime JSRuntime
@inherits ValidacionAcceso

<PageTitle>Lista de indicadores</PageTitle>

<h1>Indicadores</h1>
@* Solo los verificadores y validadores no pueden crear *@
@if (!EsVerificador && !EsValidador)
{
    <div class="mb-3">
        <button class="btn btn-primary" @onclick="MostrarFormularioCrear">Crear Nuevo</button>
    </div>
}
<div class="mb-3">
    <div class="row">
        <div class="col-md-6">
            <div class="input-group">
                <input type="text"
                       class="form-control"
                       placeholder="Buscar por código o nombre..."
                       @bind="TextoBusqueda"
                       @oninput="FiltrarIndicadores" />
                <button class="btn btn-outline-secondary" type="button" @onclick="LimpiarBusqueda">
                    <i class="fas fa-times"></i> Limpiar
                </button>
            </div>
        </div>
        <div class="col-md-6">
            <small class="text-muted">
                Mostrando @IndicadoresFiltrados.Count de @indicadores.Count indicadores
            </small>
        </div>
    </div>
</div>
@if (cargando)
{
    <p><em>Cargando...</em></p>
}
else if (indicadores == null || indicadores.Count == 0)
{
    <p>No hay Tipos de indicadores.</p>
}
else if (IndicadoresFiltrados.Count == 0 && !string.IsNullOrEmpty(TextoBusqueda))
{
    <div class="alert alert-info">
        <i class="fas fa-search"></i> No se encontraron indicadores que coincidan con "<strong>@TextoBusqueda</strong>"
    </div>
}
else if (IndicadoresFiltrados.Count == 0)
{
    <p>No hay Tipos de indicadores.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Nombre</th>
                    @* Solo los verificadores y validadores no ven las acciones de crear/editar/eliminar *@
                    @if (!EsVerificador && !EsValidador)
                    {
                        <th>Acciones</th>
                    }
                    @* Los validadores solo pueden editar, así que necesitan ver la columna de acciones si solo son validadores y no verificadores *@
                    @if (EsValidador && !EsVerificador)
                    {
                        <th>Acciones</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var tipoindicador in IndicadoresFiltrados)
                {
                    <tr>
                        <td>@ObtenerValor(tipoindicador, "id")</td>
                        <td>@ObtenerValor(tipoindicador, "nombre")</td>
                        @* Administradores pueden hacer todo *@
                        @if (!EsVerificador && !EsValidador)
                        {
                            <td>
                                <button class="btn btn-warning btn-sm" @onclick="() => MostrarFormularioEditar(tipoindicador)">Editar</button>
                                <button class="btn btn-danger btn-sm" @onclick="() => ConfirmarEliminar(tipoindicador)">Eliminar</button>
                            </td>
                        }
                        @* Los validadores solo pueden editar *@
                        @if (EsValidador && !EsVerificador)
                        {
                            <td>
                                <button class="btn btn-warning btn-sm" @onclick="() => MostrarFormularioEditar(tipoindicador)">Editar</button>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<ModalGenerico @ref="modalFormulario"
               Id="formModal"
               Title="@TituloModal"
               OnSave="GuardarIndicador">
    <BodyContent>
        <div class="mb-3">
            <label for="nombre" class="form-label">Nombre</label>
            <input type="text" class="form-control" id="nombre" @bind="indicadorActual.nombre" />
        </div>
    </BodyContent>
</ModalGenerico>

<ModalGenerico @ref="modalConfirmacion"
               Id="confirmModal"
               Title="Confirmar eliminación"
               OnSave="EliminarIndicador">
    <BodyContent>
        <p>¿Está seguro que desea eliminar el indicador: @indicadorEliminar.nombre?</p>
    </BodyContent>
</ModalGenerico>

@if (errorMensaje != null)
{
    <div class="alert alert-danger">
        Error: @errorMensaje
    </div>
}

@if (exitoMensaje != null)
{
    <div class="alert alert-success">
        @exitoMensaje
    </div>
}

@code {
    private List<Dictionary<string, object>> indicadores = new List<Dictionary<string, object>>();
    private bool cargando = true;
    private string? errorMensaje = null;
    private string? exitoMensaje = null;
    private const string TABLA = "tipoindicador";

    // Variables para control de roles
    private bool EsVerificador { get; set; } = false;
    private bool EsValidador { get; set; } = false; // Añadido para el rol de validador

    // Variables para la búsqueda
    private string TextoBusqueda { get; set; } = string.Empty;
    private List<Dictionary<string, object>> IndicadoresFiltrados { get; set; } = new();

    // Variables para el formulario
    private bool modoEdicion = false;
    private IndicadorModel indicadorActual = new IndicadorModel();
    private ModalGenerico? modalFormulario;
    private string TituloModal => $"{(modoEdicion ? "Editar" : "Crear")} Tipo de Indicador";

    // Variables para confirmación de eliminación
    private IndicadorModel indicadorEliminar = new IndicadorModel();
    private ModalGenerico? modalConfirmacion;

    protected override async Task OnInitializedAsync()
    {
        // Verificar roles del usuario
        var rol = await JSRuntime.InvokeAsync<string>("sessionStorage.getItem", "rolUsuario");
        EsVerificador = RutasPermisosService.EsRolVerificador(rol);
        EsValidador = RutasPermisosService.EsRolValidador(rol); // Obtener estado del rol Validador

        await CargarTipodeIndicadores();
    }

    private void FiltrarIndicadores(ChangeEventArgs? e = null)
    {
        if (e != null)
        {
            TextoBusqueda = e.Value?.ToString() ?? string.Empty;
        }

        if (string.IsNullOrEmpty(TextoBusqueda))
        {
            IndicadoresFiltrados = new List<Dictionary<string, object>>(indicadores);
        }
        else
        {
            var textoLower = TextoBusqueda.ToLower().Trim();
            IndicadoresFiltrados = indicadores
                .Where(ind =>
                    ObtenerValor(ind, "id").ToLower().Contains(textoLower) ||
                    ObtenerValor(ind, "nombre").ToLower().Contains(textoLower)
                )
                .ToList();
        }
        StateHasChanged();
    }

    private void LimpiarBusqueda()
    {
        TextoBusqueda = string.Empty;
        IndicadoresFiltrados = new List<Dictionary<string, object>>(indicadores);
        StateHasChanged();
    }

    private async Task CargarTipodeIndicadores()
    {
        cargando = true;
        errorMensaje = null;

        try
        {
            var resultado = await servicioEntidad.ObtenerTodosAsync(TABLA);
            indicadores = resultado ?? new List<Dictionary<string, object>>();
            IndicadoresFiltrados = new List<Dictionary<string, object>>(indicadores);

            if (!string.IsNullOrEmpty(TextoBusqueda))
            {
                FiltrarIndicadores();
            }
        }
        catch (Exception ex)
        {
            errorMensaje = $"Error al cargar: {ex.Message}";
            indicadores = new List<Dictionary<string, object>>();
            IndicadoresFiltrados = new List<Dictionary<string, object>>();
        }
        finally
        {
            cargando = false;
        }
    }

    private string ObtenerValor(Dictionary<string, object> diccionario, string clave)
    {
        if (diccionario == null)
            return string.Empty;

        if (diccionario.TryGetValue(clave, out var valor))
        {
            return valor?.ToString() ?? string.Empty;
        }

        return string.Empty;
    }

    private async Task MostrarFormularioCrear()
    {
        // Los verificadores y validadores no pueden crear
        if (EsVerificador || EsValidador)
            return;

        indicadorActual = new IndicadorModel();
        modoEdicion = false;
        await InvokeAsync(StateHasChanged);
        await modalFormulario.ShowModalAsync();
    }

    private async Task MostrarFormularioEditar(Dictionary<string, object> indicador)
    {
        // Solo los verificadores no pueden editar (los validadores sí pueden)
        if (EsVerificador)
            return;

        indicadorActual = new IndicadorModel
            {
                id = ObtenerValor(indicador, "id"),
                nombre = ObtenerValor(indicador, "nombre")
            };
        modoEdicion = true;
        await InvokeAsync(StateHasChanged);
        await modalFormulario.ShowModalAsync();
    }

    private async Task GuardarIndicador()
    {
        // Solo los verificadores no pueden guardar (los validadores sí pueden editar)
        if (EsVerificador)
            return;

        // Los validadores no pueden crear, solo editar
        if (EsValidador && !modoEdicion)
            return;

        errorMensaje = null;
        exitoMensaje = null;

        try
        {
            var indicadorDict = new Dictionary<string, object>
                {
                    ["nombre"] = indicadorActual.nombre
                };

            bool resultado;

            if (modoEdicion)
            {
                resultado = await servicioEntidad.ActualizarAsync(
                    TABLA,
                    "id",
                    indicadorActual.id,
                    indicadorDict
                );

                if (resultado)
                {
                    exitoMensaje = "Indicador actualizado correctamente.";
                }
            }
            else
            {
                resultado = await servicioEntidad.CrearAsync(
                    TABLA,
                    indicadorDict
                );

                if (resultado)
                {
                    exitoMensaje = "Indicador creado correctamente.";
                }
            }

            if (resultado)
            {
                await CargarTipodeIndicadores();
            }
            else
            {
                errorMensaje = "No se pudo guardar el indicador.";
            }
        }
        catch (Exception ex)
        {
            errorMensaje = $"Error al guardar el indicador: {ex.Message}";
        }
    }

    // Funciones para eliminar
    private async Task ConfirmarEliminar(Dictionary<string, object> indicador)
    {
        // Los verificadores y validadores no pueden eliminar
        if (EsVerificador || EsValidador)
            return;

        indicadorEliminar = new IndicadorModel
            {
                id = ObtenerValor(indicador, "id"),
                nombre = ObtenerValor(indicador, "nombre")
            };
        await InvokeAsync(StateHasChanged);
        await modalConfirmacion.ShowModalAsync();
    }

    private async Task EliminarIndicador()
    {
        // Los verificadores y validadores no pueden eliminar
        if (EsVerificador || EsValidador)
            return;

        errorMensaje = null;
        exitoMensaje = null;

        try
        {
            var resultado = await servicioEntidad.EliminarAsync(
                TABLA,
                "id",
                indicadorEliminar.id
            );

            if (resultado)
            {
                exitoMensaje = "Indicador eliminado correctamente.";
                await CargarTipodeIndicadores();
            }
            else
            {
                errorMensaje = "No se pudo eliminar el indicador.";
            }
        }
        catch (Exception ex)
        {
            errorMensaje = $"Error al eliminar el indicador: {ex.Message}";
        }
    }
}