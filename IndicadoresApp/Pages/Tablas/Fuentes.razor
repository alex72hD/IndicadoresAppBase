@page "/fuente"
@using System.Collections.Generic
@using System.Text.Json
@using IndicadoresApp.Clases.IndicadoresApp.Clases
@using IndicadoresApp.ModalGenerico @* Se añade para consistencia aunque se usen modales directos *@
@inject IJSRuntime JSRuntime
@inject ServicioEntidad servicioEntidad
@inject NavigationManager navegacionManager
@inherits ValidacionAcceso

<PageTitle>Lista de tipos de fuentes</PageTitle>

<h1>Fuentes</h1>
@* Solo los verificadores y validadores no pueden crear *@
@if (!EsVerificador && !EsValidador)
{
    <div class="mb-3">
        <button class="btn btn-primary" @onclick="MostrarFormularioCrear">Crear Nuevo</button>
    </div>
}

<div class="mb-3">
    <div class="row">
        <div class="col-md-6">
            <div class="input-group">
                <input type="text"
                       class="form-control"
                       placeholder="Buscar por código o nombre..."
                       @bind="TextoBusqueda"
                       @oninput="FiltrarFuentes" />
                <button class="btn btn-outline-secondary" type="button" @onclick="LimpiarBusqueda">
                    <i class="fas fa-times"></i> Limpiar
                </button>
            </div>
        </div>
        <div class="col-md-6">
            <small class="text-muted">
                Mostrando @FuentesFiltradas.Count de @fuentes.Count fuentes
            </small>
        </div>
    </div>
</div>

@if (cargando)
{
    <p><em>Cargando...</em></p>
}
else if (fuentes == null || fuentes.Count == 0)
{
    <p>No hay tipos de fuentes disponible</p>
}
else if (FuentesFiltradas.Count == 0 && !string.IsNullOrEmpty(TextoBusqueda))
{
    <div class="alert alert-info">
        <i class="fas fa-search"></i> No se encontraron fuentes que coincidan con "<strong>@TextoBusqueda</strong>"
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Nombre</th>
                    @* Solo los verificadores y validadores no ven las acciones de crear/editar/eliminar *@
                    @if (!EsVerificador && !EsValidador)
                    {
                        <th>Acciones</th>
                    }
                    @* Los validadores solo pueden editar, así que necesitan ver la columna de acciones si solo son validadores y no verificadores *@
                    @if (EsValidador && !EsVerificador)
                    {
                        <th>Acciones</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var fuente in FuentesFiltradas)
                {
                    <tr>
                        <td>@ObtenerValor(fuente, "id")</td>
                        <td>@ObtenerValor(fuente, "nombre")</td>
                        @* Administradores pueden hacer todo *@
                        @if (!EsVerificador && !EsValidador)
                        {
                            <td>
                                <button class="btn btn-warning btn-sm" @onclick="() => MostrarFormularioEditar(fuente)">Editar</button>
                                <button class="btn btn-danger btn-sm" @onclick="() => ConfirmarEliminar(fuente)">Eliminar</button>
                            </td>
                        }
                        @* Los validadores solo pueden editar *@
                        @if (EsValidador && !EsVerificador)
                        {
                            <td>
                                <button class="btn btn-warning btn-sm" @onclick="() => MostrarFormularioEditar(fuente)">Editar</button>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@* Aquí se mantienen tus modales directos con la visibilidad controlada por los roles *@
@if (mostrarFormulario)
{
    <div class="modal" style="display:block; background-color: rgba(0,0,0,0.4);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(modoEdicion ? "Editar" : "Crear") fuente</h5>
                    <button type="button" class="btn-close" @onclick="CerrarFormulario"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="nombre" class="form-label">nombre</label>
                        <input type="text" class="form-control" id="nombre" @bind="fuenteActual.nombre" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CerrarFormulario">Cancelar</button>
                    <button type="button" class="btn btn-primary" @onclick="Guardarfuente">Guardar</button>
                </div>
            </div>
        </div>
    </div>
}

@if (mostrarConfirmacion)
{
    <div class="modal" style="display:block; background-color: rgba(0,0,0,0.4);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmar eliminación</h5>
                    <button type="button" class="btn-close" @onclick="CancelarEliminar"></button>
                </div>
                <div class="modal-body">
                    <p>¿Está seguro que desea eliminar la fuente: @fuenteEliminar.nombre?</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CancelarEliminar">Cancelar</button>
                    <button type="button" class="btn btn-danger" @onclick="Eliminarfuente">Eliminar</button>
                </div>
            </div>
        </div>
    </div>
}

@if (errorMensaje != null)
{
    <div class="alert alert-danger">
        Error: @errorMensaje
    </div>
}

@if (exitoMensaje != null)
{
    <div class="alert alert-success">
        @exitoMensaje
    </div>
}

@code {
    // Lista para almacenar las fuentes que se obtienen de la API
    private List<Dictionary<string, object>> fuentes = new List<Dictionary<string, object>>();
    private List<Dictionary<string, object>> FuentesFiltradas = new List<Dictionary<string, object>>();

    private bool cargando = true;
    private string? errorMensaje = null;
    private string? exitoMensaje = null;
    private const string TABLA = "fuente";

    // Variables para control de roles
    private bool EsVerificador { get; set; } = false;
    private bool EsValidador { get; set; } = false; // <-- Añadido: Declaración de EsValidador

    // Variables para la búsqueda
    private string TextoBusqueda { get; set; } = string.Empty;

    // Variables para el formulario
    private bool mostrarFormulario = false;
    private bool modoEdicion = false;
    private FuenteModel fuenteActual = new FuenteModel();

    // Variables para confirmación de eliminación
    private bool mostrarConfirmacion = false;
    private FuenteModel fuenteEliminar = new FuenteModel();

    protected override async Task OnInitializedAsync()
    {
        var rol = await JSRuntime.InvokeAsync<string>("sessionStorage.getItem", "rolUsuario");
        EsVerificador = RutasPermisosService.EsRolVerificador(rol);
        EsValidador = RutasPermisosService.EsRolValidador(rol); // <-- Añadido: Inicialización de EsValidador

        await CargarFuentes();
    }

    private async Task CargarFuentes()
    {
        cargando = true;
        errorMensaje = null;

        try
        {
            var resultado = await servicioEntidad.ObtenerTodosAsync(TABLA);

            fuentes = resultado ?? new List<Dictionary<string, object>>();
            FuentesFiltradas = new List<Dictionary<string, object>>(fuentes);

            // Aplicar filtro si hay texto de búsqueda
            if (!string.IsNullOrEmpty(TextoBusqueda))
            {
                FiltrarFuentes();
            }
        }
        catch (Exception ex)
        {
            errorMensaje = $"Error al cargar las fuentes: {ex.Message}";
            fuentes = new List<Dictionary<string, object>>();
            FuentesFiltradas = new List<Dictionary<string, object>>();
        }
        finally
        {
            cargando = false;
        }
    }

    private string ObtenerValor(Dictionary<string, object> diccionario, string clave)
    {
        if (diccionario == null)
            return string.Empty;

        if (diccionario.TryGetValue(clave, out var valor))
        {
            return valor?.ToString() ?? string.Empty;
        }

        return string.Empty;
    }

    private void FiltrarFuentes(ChangeEventArgs? e = null)
    {
        if (e != null)
        {
            TextoBusqueda = e.Value?.ToString() ?? string.Empty;
        }

        if (string.IsNullOrEmpty(TextoBusqueda))
        {
            FuentesFiltradas = new List<Dictionary<string, object>>(fuentes);
        }
        else
        {
            var textoBusquedaLower = TextoBusqueda.ToLower().Trim();

            FuentesFiltradas = fuentes.Where(fuente =>
            {
                var codigo = ObtenerValor(fuente, "id").ToLower();
                var nombre = ObtenerValor(fuente, "nombre").ToLower();

                return codigo.Contains(textoBusquedaLower) ||
                       nombre.Contains(textoBusquedaLower);
            }).ToList();
        }

        StateHasChanged();
    }

    private void LimpiarBusqueda()
    {
        TextoBusqueda = string.Empty;
        FuentesFiltradas = new List<Dictionary<string, object>>(fuentes);
        StateHasChanged();
    }

    private void MostrarFormularioCrear()
    {
        // <-- Modificado: Los verificadores y validadores no pueden crear
        if (EsVerificador || EsValidador)
            return;
        fuenteActual = new FuenteModel();
        modoEdicion = false;
        mostrarFormulario = true;
    }

    private void MostrarFormularioEditar(Dictionary<string, object> fuente)
    {
        // <-- Modificado: Solo los verificadores no pueden editar (los validadores sí pueden)
        if (EsVerificador)
            return;

        fuenteActual = new FuenteModel
            {
                id = ObtenerValor(fuente, "id"),
                nombre = ObtenerValor(fuente, "nombre")
            };
        modoEdicion = true;
        mostrarFormulario = true;
    }

    private void CerrarFormulario()
    {
        mostrarFormulario = false;
    }

    private async Task Guardarfuente()
    {
        // <-- Modificado: Solo los verificadores no pueden guardar (los validadores sí pueden editar)
        if (EsVerificador)
            return;

        // <-- Añadido: Los validadores no pueden crear, solo editar
        if (EsValidador && !modoEdicion)
            return;

        errorMensaje = null;
        exitoMensaje = null;

        try
        {
            var fuenteDict = new Dictionary<string, object>
                {
                    ["nombre"] = fuenteActual.nombre
                };

            bool resultado;

            if (modoEdicion)
            {
                resultado = await servicioEntidad.ActualizarAsync(
                    TABLA,
                    "id",
                    fuenteActual.id,
                    fuenteDict
                );

                if (resultado)
                {
                    exitoMensaje = "Fuente actualizada correctamente.";
                }
            }
            else
            {
                resultado = await servicioEntidad.CrearAsync(
                    TABLA,
                    fuenteDict
                );

                if (resultado)
                {
                    exitoMensaje = "Fuente creada correctamente.";
                }
            }

            if (resultado)
            {
                await CargarFuentes();
                mostrarFormulario = false;
            }
            else
            {
                errorMensaje = "No se pudo guardar la fuente.";
            }
        }
        catch (Exception ex)
        {
            errorMensaje = $"Error al guardar la fuente: {ex.Message}";
        }
    }

    private void ConfirmarEliminar(Dictionary<string, object> fuente)
    {
        // <-- Modificado: Los verificadores y validadores no pueden eliminar
        if (EsVerificador || EsValidador)
            return;
        fuenteEliminar = new FuenteModel
            {
                id = ObtenerValor(fuente, "id"),
                nombre = ObtenerValor(fuente, "nombre")
            };
        mostrarConfirmacion = true;
    }

    private void CancelarEliminar()
    {
        mostrarConfirmacion = false;
    }

    private async Task Eliminarfuente()
    {
        // <-- Modificado: Los verificadores y validadores no pueden eliminar
        if (EsVerificador || EsValidador)
            return;

        errorMensaje = null;
        exitoMensaje = null;

        try
        {
            var resultado = await servicioEntidad.EliminarAsync(
                TABLA,
                "id",
                fuenteEliminar.id
            );

            if (resultado)
            {
                exitoMensaje = "Fuente eliminada correctamente.";
                await CargarFuentes();
            }
            else
            {
                errorMensaje = "No se pudo eliminar la fuente.";
            }

            mostrarConfirmacion = false;
        }
        catch (Exception ex)
        {
            errorMensaje = $"Error al eliminar la fuente: {ex.Message}";
        }
    }
}