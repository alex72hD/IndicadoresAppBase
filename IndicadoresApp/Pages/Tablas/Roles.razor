@page "/rol"
@using System.Collections.Generic
@using System.Text.Json
@inject ServicioEntidad servicioEntidad
@inject NavigationManager navegacionManager
@inherits ValidacionAcceso

<PageTitle>Lista de tipos de roles</PageTitle>

<h1>roles</h1>

<div class="mb-3">
    <button class="btn btn-primary" @onclick="MostrarFormularioCrear">Crear Nuevo</button>
</div>

<div class="mb-3">
    <div class="row">
        <div class="col-md-6">
            <div class="input-group">
                <input type="text"
                       class="form-control"
                       placeholder="Buscar por código o nombre..."
                       @bind="TextoBusqueda"
                       @oninput="FiltrarRoles" />
                <button class="btn btn-outline-secondary" type="button" @onclick="LimpiarBusqueda">
                    <i class="fas fa-times"></i> Limpiar
                </button>
            </div>
        </div>
        <div class="col-md-6">
            <small class="text-muted">
                Mostrando @RolesFiltrados.Count de @roles.Count roles
            </small>
        </div>
    </div>
</div>

@if (cargando)
{
    <p><em>Cargando...</em></p>
}
else if (roles == null || roles.Count == 0)
{
    <p>No hay tipos de roles disponibles.</p>
}
else if (RolesFiltrados.Count == 0 && !string.IsNullOrEmpty(TextoBusqueda))
{
    <div class="alert alert-info">
        <i class="fas fa-search"></i> No se encontraron roles que coincidan con "<strong>@TextoBusqueda</strong>"
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>nombre</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var rol in RolesFiltrados)
                {
                    <tr>
                        <td>@ObtenerValor(rol, "id")</td>
                        <td>@ObtenerValor(rol, "nombre")</td>
                        <td>
                            <button class="btn btn-warning btn-sm" @onclick="() => MostrarFormularioEditar(rol)">Editar</button>
                            <button class="btn btn-danger btn-sm" @onclick="() => ConfirmarEliminar(rol)">Eliminar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (mostrarFormulario)
{
    <div class="modal" style="display:block; background-color: rgba(0,0,0,0.4);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(modoEdicion ? "Editar" : "Crear") rol</h5>
                    <button type="button" class="btn-close" @onclick="CerrarFormulario"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="nombre" class="form-label">nombre</label>
                        <input type="text" class="form-control" id="nombre" @bind="rolActual.nombre" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CerrarFormulario">Cancelar</button>
                    <button type="button" class="btn btn-primary" @onclick="Guardarrol">Guardar</button>
                </div>
            </div>
        </div>
    </div>
}

@if (mostrarConfirmacion)
{
    <div class="modal" style="display:block; background-color: rgba(0,0,0,0.4);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmar eliminación</h5>
                    <button type="button" class="btn-close" @onclick="CancelarEliminar"></button>
                </div>
                <div class="modal-body">
                    <p>¿Está seguro que desea eliminar la rol: @rolEliminar?.nombre?</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CancelarEliminar">Cancelar</button>
                    <button type="button" class="btn btn-danger" @onclick="Eliminarrol">Eliminar</button>
                </div>
            </div>
        </div>
    </div>
}

@if (errorMensaje != null)
{
    <div class="alert alert-danger">
        Error: @errorMensaje
    </div>
}

@if (exitoMensaje != null)
{
    <div class="alert alert-success">
        @exitoMensaje
    </div>
}

@code {
    private List<Dictionary<string, object>> roles = new List<Dictionary<string, object>>();
    private List<Dictionary<string, object>> RolesFiltrados = new List<Dictionary<string, object>>(); // New list for filtered data
    private bool cargando = true;
    private string? errorMensaje = null;
    private string? exitoMensaje = null;
    private const string TABLA = "rol";

    // Variables para la búsqueda
    private string TextoBusqueda { get; set; } = string.Empty;

    // Variables para el formulario
    private bool mostrarFormulario = false;
    private bool modoEdicion = false;
    private RolModel rolActual = new RolModel();

    // Variables para confirmación de eliminación
    private bool mostrarConfirmacion = false;
    private RolModel rolEliminar = new RolModel();

    protected override async Task OnInitializedAsync()
    {
        await CargarRoles(); // Renamed for clarity
    }

    private async Task CargarRoles() // Renamed method
    {
        cargando = true;
        errorMensaje = null;

        try
        {
            var resultado = await servicioEntidad.ObtenerTodosAsync(TABLA);

            roles = resultado ?? new List<Dictionary<string, object>>();
            RolesFiltrados = new List<Dictionary<string, object>>(roles); // Initialize filtered list

            // Apply filter if there's existing search text
            if (!string.IsNullOrEmpty(TextoBusqueda))
            {
                FiltrarRoles();
            }
        }
        catch (Exception ex)
        {
            errorMensaje = $"Error al cargar los roles: {ex.Message}";
            roles = new List<Dictionary<string, object>>();
            RolesFiltrados = new List<Dictionary<string, object>>();
        }
        finally
        {
            cargando = false;
        }
    }

    private string ObtenerValor(Dictionary<string, object> diccionario, string clave)
    {
        if (diccionario == null)
            return string.Empty;

        if (diccionario.TryGetValue(clave, out var valor))
        {
            return valor?.ToString() ?? string.Empty;
        }

        return string.Empty;
    }

    private void FiltrarRoles(ChangeEventArgs? e = null)
    {
        if (e != null)
        {
            TextoBusqueda = e.Value?.ToString() ?? string.Empty;
        }

        if (string.IsNullOrEmpty(TextoBusqueda))
        {
            RolesFiltrados = new List<Dictionary<string, object>>(roles);
        }
        else
        {
            var textoBusquedaLower = TextoBusqueda.ToLower().Trim();

            RolesFiltrados = roles.Where(rol =>
            {
                var codigo = ObtenerValor(rol, "id").ToLower();
                var nombre = ObtenerValor(rol, "nombre").ToLower();

                return codigo.Contains(textoBusquedaLower) ||
                       nombre.Contains(textoBusquedaLower);
            }).ToList();
        }

        StateHasChanged(); // Notify Blazor that the state has changed and UI should re-render
    }

    private void LimpiarBusqueda()
    {
        TextoBusqueda = string.Empty;
        RolesFiltrados = new List<Dictionary<string, object>>(roles);
        StateHasChanged();
    }

    private void MostrarFormularioCrear()
    {
        rolActual = new RolModel();
        modoEdicion = false;
        mostrarFormulario = true;
    }

    private void MostrarFormularioEditar(Dictionary<string, object> rol)
    {
        rolActual = new RolModel
        {
            id = ObtenerValor(rol, "id"),
            nombre = ObtenerValor(rol, "nombre")
        };
        modoEdicion = true;
        mostrarFormulario = true;
    }

    private void CerrarFormulario()
    {
        mostrarFormulario = false;
    }

    private async Task Guardarrol()
    {
        errorMensaje = null;
        exitoMensaje = null;

        try
        {
            var rolDict = new Dictionary<string, object>
            {
                ["nombre"] = rolActual.nombre
            };

            bool resultado;

            if (modoEdicion)
            {
                resultado = await servicioEntidad.ActualizarAsync(
                    TABLA,
                    "id",
                    rolActual.id,
                    rolDict
                );

                if (resultado)
                {
                    exitoMensaje = "Rol actualizado correctamente.";
                }
            }
            else
            {
                resultado = await servicioEntidad.CrearAsync(
                    TABLA,
                    rolDict
                );

                if (resultado)
                {
                    exitoMensaje = "Rol creado correctamente.";
                }
            }

            if (resultado)
            {
                await CargarRoles(); // Renamed method
                mostrarFormulario = false;
            }
            else
            {
                errorMensaje = "No se pudo guardar el rol.";
            }
        }
        catch (Exception ex)
        {
            errorMensaje = $"Error al guardar el rol: {ex.Message}";
        }
    }

    private void ConfirmarEliminar(Dictionary<string, object> rol)
    {
        rolEliminar = new RolModel
        {
            id = ObtenerValor(rol, "id"),
            nombre = ObtenerValor(rol, "nombre")
        };
        mostrarConfirmacion = true;
    }

    private void CancelarEliminar()
    {
        mostrarConfirmacion = false;
    }

    private async Task Eliminarrol()
    {
        errorMensaje = null;
        exitoMensaje = null;

        try
        {
            var resultado = await servicioEntidad.EliminarAsync(
                TABLA,
                "id",
                rolEliminar.id
            );

            if (resultado)
            {
                exitoMensaje = "Rol eliminado correctamente.";
                await CargarRoles(); // Renamed method
            }
            else
            {
                errorMensaje = "No se pudo eliminar el rol.";
            }

            mostrarConfirmacion = false;
        }
        catch (Exception ex)
        {
            errorMensaje = $"Error al eliminar el rol: {ex.Message}";
        }
    }

    // You might need a RolModel class if it doesn't exist. Example:
    public class RolModel
    {
        public string? id { get; set; }
        public string? nombre { get; set; }
    }
}