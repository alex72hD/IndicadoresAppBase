@page "/representante"
@using System.Collections.Generic
@using System.Text.Json
@inject IJSRuntime JSRuntime
@using IndicadoresApp.Clases.IndicadoresApp.Clases

@inject ServicioEntidad servicioEntidad
@inject NavigationManager navegacionManager
@inherits ValidacionAcceso

<PageTitle>Lista de tipos de representantees</PageTitle>

<h1>Representantes</h1>
@if (!EsVerificador)
{
    <div class="mb-3">
        <button class="btn btn-primary" @onclick="MostrarFormularioCrear">Crear Nuevo</button>
    </div>
}

<div class="mb-3">
    <div class="row">
        <div class="col-md-6">
            <div class="input-group">
                <input type="text"
                       class="form-control"
                       placeholder="Buscar por código o nombre..."
                       @bind="TextoBusqueda"
                       @oninput="FiltrarRepresentantes" />
                <button class="btn btn-outline-secondary" type="button" @onclick="LimpiarBusqueda">
                    <i class="fas fa-times"></i> Limpiar
                </button>
            </div>
        </div>
        <div class="col-md-6">
            <small class="text-muted">
                Mostrando @RepresentantesFiltrados.Count de @representantes.Count representantes
            </small>
        </div>
    </div>
</div>

@if (cargando)
{
    <p><em>Cargando...</em></p>
}
else if (representantes == null || representantes.Count == 0)
{
    <p>No hay tipos de representantes disponible</p>
}
else if (RepresentantesFiltrados.Count == 0 && !string.IsNullOrEmpty(TextoBusqueda))
{
    <div class="alert alert-info">
        <i class="fas fa-search"></i> No se encontraron representantes que coincidan con "<strong>@TextoBusqueda</strong>"
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>nombre</th>
                    @if (!EsVerificador)
                    {
                        <th>Acciones</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var representante in RepresentantesFiltrados)
                {
                    <tr>
                        <td>@ObtenerValor(representante, "id")</td>
                        <td>@ObtenerValor(representante, "nombre")</td>
                        @if (!EsVerificador)
                        {
                            <td>
                                <button class="btn btn-warning btn-sm" @onclick="() => MostrarFormularioEditar(representante)">Editar</button>
                                <button class="btn btn-danger btn-sm" @onclick="() => ConfirmarEliminar(representante)">Eliminar</button>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (mostrarFormulario)
{
    <div class="modal" style="display:block; background-color: rgba(0,0,0,0.4);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(modoEdicion ? "Editar" : "Crear") representante</h5>
                    <button type="button" class="btn-close" @onclick="CerrarFormulario"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="nombre" class="form-label">nombre</label>
                        <input type="text" class="form-control" id="nombre" @bind="representanteActual.nombre" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CerrarFormulario">Cancelar</button>
                    <button type="button" class="btn btn-primary" @onclick="Guardarrepresentante">Guardar</button>
                </div>
            </div>
        </div>
    </div>
}

@if (mostrarConfirmacion)
{
    <div class="modal" style="display:block; background-color: rgba(0,0,0,0.4);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmar eliminación</h5>
                    <button type="button" class="btn-close" @onclick="CancelarEliminar"></button>
                </div>
                <div class="modal-body">
                    <p>¿Está seguro que desea eliminar el representante: @representanteEliminar?.nombre?</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CancelarEliminar">Cancelar</button>
                    <button type="button" class="btn btn-danger" @onclick="Eliminarrepresentante">Eliminar</button>
                </div>
            </div>
        </div>
    </div>
}

@if (errorMensaje != null)
{
    <div class="alert alert-danger">
        Error: @errorMensaje
    </div>
}

@if (exitoMensaje != null)
{
    <div class="alert alert-success">
        @exitoMensaje
    </div>
}

@code {
    // Lista para almacenar los representantes que se obtienen de la API
    private List<Dictionary<string, object>> representantes = new List<Dictionary<string, object>>();
    private List<Dictionary<string, object>> RepresentantesFiltrados = new List<Dictionary<string, object>>();

    private bool cargando = true;
    private string? errorMensaje = null;
    private string? exitoMensaje = null;
    private const string TABLA = "represenvisual";
    private bool EsVerificador { get; set; } = false;

    // Variables para la búsqueda
    private string TextoBusqueda { get; set; } = string.Empty;

    // Variables para el formulario
    private bool mostrarFormulario = false;
    private bool modoEdicion = false;
    private RepresentanteModel representanteActual = new RepresentanteModel();

    // Variables para confirmación de eliminación
    private bool mostrarConfirmacion = false;
    private RepresentanteModel representanteEliminar = new RepresentanteModel();

    protected override async Task OnInitializedAsync()
    {
        var rol = await JSRuntime.InvokeAsync<string>("sessionStorage.getItem", "rolUsuario");
        EsVerificador = RutasPermisosService.EsRolVerificador(rol);

        await CargarRepresentantes(); // Changed from Cargarunidadmedicion to CargarRepresentantes for clarity
    }

    private async Task CargarRepresentantes() // Changed method name
    {
        cargando = true;
        errorMensaje = null;

        try
        {
            var resultado = await servicioEntidad.ObtenerTodosAsync(TABLA);

            representantes = resultado ?? new List<Dictionary<string, object>>();
            RepresentantesFiltrados = new List<Dictionary<string, object>>(representantes);

            // Aplicar filtro si hay texto de búsqueda
            if (!string.IsNullOrEmpty(TextoBusqueda))
            {
                FiltrarRepresentantes();
            }
        }
        catch (Exception ex)
        {
            errorMensaje = $"Error al cargar los representantes: {ex.Message}";
            representantes = new List<Dictionary<string, object>>();
            RepresentantesFiltrados = new List<Dictionary<string, object>>();
        }
        finally
        {
            cargando = false;
        }
    }

    private string ObtenerValor(Dictionary<string, object> diccionario, string clave)
    {
        if (diccionario == null)
            return string.Empty;

        if (diccionario.TryGetValue(clave, out var valor))
        {
            return valor?.ToString() ?? string.Empty;
        }

        return string.Empty;
    }

    private void FiltrarRepresentantes(ChangeEventArgs? e = null)
    {
        if (e != null)
        {
            TextoBusqueda = e.Value?.ToString() ?? string.Empty;
        }

        if (string.IsNullOrEmpty(TextoBusqueda))
        {
            RepresentantesFiltrados = new List<Dictionary<string, object>>(representantes);
        }
        else
        {
            var textoBusquedaLower = TextoBusqueda.ToLower().Trim();

            RepresentantesFiltrados = representantes.Where(representante =>
            {
                var codigo = ObtenerValor(representante, "id").ToLower();
                var nombre = ObtenerValor(representante, "nombre").ToLower();

                return codigo.Contains(textoBusquedaLower) ||
                       nombre.Contains(textoBusquedaLower);
            }).ToList();
        }

        StateHasChanged();
    }

    private void LimpiarBusqueda()
    {
        TextoBusqueda = string.Empty;
        RepresentantesFiltrados = new List<Dictionary<string, object>>(representantes);
        StateHasChanged();
    }

    private void MostrarFormularioCrear()
    {
        if (EsVerificador)
            return;
        representanteActual = new RepresentanteModel();
        modoEdicion = false;
        mostrarFormulario = true;
    }

    private void MostrarFormularioEditar(Dictionary<string, object> representante)
    {
        if (EsVerificador)
            return;
        representanteActual = new RepresentanteModel
        {
            id = ObtenerValor(representante, "id"),
            nombre = ObtenerValor(representante, "nombre")
        };
        modoEdicion = true;
        mostrarFormulario = true;
    }

    private void CerrarFormulario()
    {
        mostrarFormulario = false;
    }

    private async Task Guardarrepresentante()
    {
        if (EsVerificador)
            return;
        errorMensaje = null;
        exitoMensaje = null;

        try
        {
            var representanteDict = new Dictionary<string, object>
            {
                ["nombre"] = representanteActual.nombre
            };

            bool resultado;

            if (modoEdicion)
            {
                resultado = await servicioEntidad.ActualizarAsync(
                    TABLA,
                    "id",
                    representanteActual.id,
                    representanteDict
                );

                if (resultado)
                {
                    exitoMensaje = "Representante actualizado correctamente.";
                }
            }
            else
            {
                resultado = await servicioEntidad.CrearAsync(
                    TABLA,
                    representanteDict
                );

                if (resultado)
                {
                    exitoMensaje = "Representante creado correctamente.";
                }
            }

            if (resultado)
            {
                await CargarRepresentantes(); // Changed method name
                mostrarFormulario = false;
            }
            else
            {
                errorMensaje = "No se pudo guardar el representante.";
            }
        }
        catch (Exception ex)
        {
            errorMensaje = $"Error al guardar el representante: {ex.Message}";
        }
    }

    private void ConfirmarEliminar(Dictionary<string, object> representante)
    {
        if (EsVerificador)
            return;
        representanteEliminar = new RepresentanteModel
        {
            id = ObtenerValor(representante, "id"),
            nombre = ObtenerValor(representante, "nombre")
        };
        mostrarConfirmacion = true;
    }

    private void CancelarEliminar()
    {
        mostrarConfirmacion = false;
    }

    private async Task Eliminarrepresentante()
    {
        errorMensaje = null;
        exitoMensaje = null;

        try
        {
            var resultado = await servicioEntidad.EliminarAsync(
                TABLA,
                "id",
                representanteEliminar.id
            );

            if (resultado)
            {
                exitoMensaje = "Representante eliminado correctamente.";
                await CargarRepresentantes(); // Changed method name
            }
            else
            {
                errorMensaje = "No se pudo eliminar el representante.";
            }

            mostrarConfirmacion = false;
        }
        catch (Exception ex)
        {
            errorMensaje = $"Error al eliminar el representante: {ex.Message}";
        }
    }
}