@page "/sentido"  
@using System.Collections.Generic  
@using System.Text.Json  
@using IndicadoresApp.Clases.IndicadoresApp.Clases
@inject IJSRuntime JSRuntime
@inject ServicioEntidad servicioEntidad  
@inject NavigationManager navegacionManager  
@inherits ValidacionAcceso

<PageTitle>Lista de tipos de sentidos</PageTitle>

<h1>Sentidos</h1>  
@if (!EsVerificador)
{
    <div class="mb-3">
        <button class="btn btn-primary" @onclick="MostrarFormularioCrear">Crear Nuevo</button> 
    </div>
}

<!-- Campo de búsqueda -->
<div class="mb-3">
    <div class="row">
        <div class="col-md-6">
            <div class="input-group">
                <input type="text" 
                       class="form-control" 
                       placeholder="Buscar por código o nombre..." 
                       @bind="TextoBusqueda" 
                       @oninput="FiltrarSentidos" />
                <button class="btn btn-outline-secondary" type="button" @onclick="LimpiarBusqueda">
                    <i class="fas fa-times"></i> Limpiar
                </button>
            </div>
        </div>
        <div class="col-md-6">
            <small class="text-muted">
                Mostrando @SentidosFiltrados.Count de @sentidos.Count sentidos
            </small>
        </div>
    </div>
</div>

@if (cargando)
{
    <p><em>Cargando...</em></p>
}
else if (sentidos == null || sentidos.Count == 0)
{
    <p>No hay tipos de sentidos disponible</p>  
}
else if (SentidosFiltrados.Count == 0 && !string.IsNullOrEmpty(TextoBusqueda))
{
    <div class="alert alert-info">
        <i class="fas fa-search"></i> No se encontraron sentidos que coincidan con "<strong>@TextoBusqueda</strong>"
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Nombre</th>
                    @if (!EsVerificador)
                    {
                        <th>Acciones</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var sentido in SentidosFiltrados)
                {
                    <tr>
                        <td>@ObtenerValor(sentido, "id")</td>
                        <td>@ObtenerValor(sentido, "nombre")</td>
                        @if (!EsVerificador)
                        {
                            <td>
                                <button class="btn btn-warning btn-sm" @onclick="() => MostrarFormularioEditar(sentido)">Editar</button>
                                <button class="btn btn-danger btn-sm" @onclick="() => ConfirmarEliminar(sentido)">Eliminar</button>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (mostrarFormulario)
{
    <div class="modal" style="display:block; background-color: rgba(0,0,0,0.4);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(modoEdicion ? "Editar" : "Crear") sentido</h5>
                    <button type="button" class="btn-close" @onclick="CerrarFormulario"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="nombre" class="form-label">nombre</label>
                        <input type="text" class="form-control" id="nombre" @bind="sentidoActual.nombre" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CerrarFormulario">Cancelar</button>
                    <button type="button" class="btn btn-primary" @onclick="Guardarsentido">Guardar</button>
                </div>
            </div>
        </div>
    </div>
}

@if (mostrarConfirmacion)
{
    <div class="modal" style="display:block; background-color: rgba(0,0,0,0.4);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmar eliminación</h5>
                    <button type="button" class="btn-close" @onclick="CancelarEliminar"></button>
                </div>
                <div class="modal-body">
                    <p>¿Está seguro que desea eliminar la sentido: @sentidoEliminar?.nombre?</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CancelarEliminar">Cancelar</button>
                    <button type="button" class="btn btn-danger" @onclick="Eliminarsentido">Eliminar</button>
                </div>
            </div>
        </div>
    </div>
}

@if (errorMensaje != null)
{
    <div class="alert alert-danger">
        Error: @errorMensaje
    </div>
}

@if (exitoMensaje != null)
{
    <div class="alert alert-success">
        @exitoMensaje
    </div>
}

@code {
    // Lista para almacenar los sentidos que se obtienen de la API
    private List<Dictionary<string, object>> sentidos = new List<Dictionary<string, object>>();
    private List<Dictionary<string, object>> SentidosFiltrados = new List<Dictionary<string, object>>();
    
    private bool cargando = true;
    private string? errorMensaje = null;
    private string? exitoMensaje = null;
    private const string TABLA = "sentido";
    private bool EsVerificador { get; set; } = false;

    // Variables para la búsqueda
    private string TextoBusqueda { get; set; } = string.Empty;

    // Variables para el formulario
    private bool mostrarFormulario = false;
    private bool modoEdicion = false;
    private SentidoModel sentidoActual = new SentidoModel();

    // Variables para confirmación de eliminación
    private bool mostrarConfirmacion = false;
    private SentidoModel sentidoEliminar = new SentidoModel();

    protected override async Task OnInitializedAsync()
    {
        var rol = await JSRuntime.InvokeAsync<string>("sessionStorage.getItem", "rolUsuario");
        EsVerificador = RutasPermisosService.EsRolVerificador(rol);

        await CargarSentidos();
    }

    private async Task CargarSentidos()
    {
        cargando = true;
        errorMensaje = null;
        
        try
        {
            var resultado = await servicioEntidad.ObtenerTodosAsync(TABLA);
            
            sentidos = resultado ?? new List<Dictionary<string, object>>();
            SentidosFiltrados = new List<Dictionary<string, object>>(sentidos);
            
            // Aplicar filtro si hay texto de búsqueda
            if (!string.IsNullOrEmpty(TextoBusqueda))
            {
                FiltrarSentidos();
            }
        }
        catch (Exception ex)
        {
            errorMensaje = $"Error al cargar los sentidos: {ex.Message}";
            sentidos = new List<Dictionary<string, object>>();
            SentidosFiltrados = new List<Dictionary<string, object>>();
        }
        finally
        {
            cargando = false;
        }
    }

    private string ObtenerValor(Dictionary<string, object> diccionario, string clave)
    {
        if (diccionario == null)
            return string.Empty;
            
        if (diccionario.TryGetValue(clave, out var valor))
        {
            return valor?.ToString() ?? string.Empty;
        }
        
        return string.Empty;
    }

    private void FiltrarSentidos(ChangeEventArgs? e = null)
    {
        if (e != null)
        {
            TextoBusqueda = e.Value?.ToString() ?? string.Empty;
        }

        if (string.IsNullOrEmpty(TextoBusqueda))
        {
            SentidosFiltrados = new List<Dictionary<string, object>>(sentidos);
        }
        else
        {
            var textoBusquedaLower = TextoBusqueda.ToLower().Trim();
            
            SentidosFiltrados = sentidos.Where(sentido =>
            {
                var codigo = ObtenerValor(sentido, "id").ToLower();
                var nombre = ObtenerValor(sentido, "nombre").ToLower();
                
                return codigo.Contains(textoBusquedaLower) || 
                       nombre.Contains(textoBusquedaLower);
            }).ToList();
        }

        StateHasChanged();
    }

    private void LimpiarBusqueda()
    {
        TextoBusqueda = string.Empty;
        SentidosFiltrados = new List<Dictionary<string, object>>(sentidos);
        StateHasChanged();
    }

    private void MostrarFormularioCrear()
    {
        if (EsVerificador)
            return;
        sentidoActual = new SentidoModel();
        modoEdicion = false;
        mostrarFormulario = true;
    }

    private void MostrarFormularioEditar(Dictionary<string, object> sentido)
    {
        if (EsVerificador)
            return;
        sentidoActual = new SentidoModel
        {
            id = ObtenerValor(sentido, "id"),
            nombre = ObtenerValor(sentido, "nombre")
        };
        modoEdicion = true;
        mostrarFormulario = true;
    }

    private void CerrarFormulario()
    {
        mostrarFormulario = false;
    }

    private async Task Guardarsentido()
    {
        if (EsVerificador)
            return;
        errorMensaje = null;
        exitoMensaje = null;

        try
        {
            var sentidoDict = new Dictionary<string, object>
            {
                ["nombre"] = sentidoActual.nombre
            };

            bool resultado;

            if (modoEdicion)
            {
                resultado = await servicioEntidad.ActualizarAsync(
                    TABLA,
                    "id",
                    sentidoActual.id,
                    sentidoDict
                );

                if (resultado)
                {
                    exitoMensaje = "Sentido actualizado correctamente.";
                }
            }
            else
            {
                resultado = await servicioEntidad.CrearAsync(
                    TABLA,
                    sentidoDict
                );

                if (resultado)
                {
                    exitoMensaje = "Sentido creado correctamente.";
                }
            }

            if (resultado)
            {
                await CargarSentidos();
                mostrarFormulario = false;
            }
            else
            {
                errorMensaje = "No se pudo guardar el sentido.";
            }
        }
        catch (Exception ex)
        {
            errorMensaje = $"Error al guardar el sentido: {ex.Message}";
        }
    }

    private void ConfirmarEliminar(Dictionary<string, object> sentido)
    {
        if (EsVerificador)
            return;
        sentidoEliminar = new SentidoModel
        {
            id = ObtenerValor(sentido, "id"),
            nombre = ObtenerValor(sentido, "nombre")
        };
        mostrarConfirmacion = true;
    }

    private void CancelarEliminar()
    {
        mostrarConfirmacion = false;
    }

    private async Task Eliminarsentido()
    {
        errorMensaje = null;
        exitoMensaje = null;

        try
        {
            var resultado = await servicioEntidad.EliminarAsync(
                TABLA,
                "id",
                sentidoEliminar.id
            );

            if (resultado)
            {
                exitoMensaje = "Sentido eliminado correctamente.";
                await CargarSentidos();
            }
            else
            {
                errorMensaje = "No se pudo eliminar el sentido.";
            }

            mostrarConfirmacion = false;
        }
        catch (Exception ex)
        {
            errorMensaje = $"Error al eliminar el sentido: {ex.Message}";
        }
    }
}